{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Raf": ""
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Jwt": {
    "Issuer": "raf",
    "Audience": "raf-client",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Confidential": {
    "Provider": "local",
    "LocalKey": ""
  },
  "Clients": {
    "MinVersion": "0.0.0"
  },
  "Cors": {
    "AllowedOrigins": ""
  },
  "Relay": {
    "Enabled": true,
    "AllowedPrivateHosts": [],
    "MaxRequestBytes": 10485760,
    "MaxResponseBytes": 10485760,
    "MaxTimeoutSeconds": 120,
    "PerMinute": 120
  },
  "Bootstrap": {
    "AdminEmail": "",
    "AdminPassword": "",
    "AdminDisplayName": "Administrador",
    "AdminMustChangePassword": true
  }
}
