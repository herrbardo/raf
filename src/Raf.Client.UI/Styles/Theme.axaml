<!--
  Paleta de RAF. Es el único lugar con colores literales: el resto de la UI usa estas claves con DynamicResource,
  así responde al cambio de tema del sistema. Diseñada primero para oscuro (D7); claro tiene sus propios valores.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Colores que FluentTheme usa en sus controles (botón accent, selección, foco, fondo de ventana). -->
  <Color x:Key="RafAccentColorDark">#7B7FF6</Color>
  <Color x:Key="RafAccentColorLight">#4F46E5</Color>
  <Color x:Key="RafRegionColorDark">#111318</Color>
  <Color x:Key="RafRegionColorLight">#F4F5F8</Color>

  <!-- Tipografía, espaciado y radios -->
  <FontFamily x:Key="RafMonoFont">Cascadia Mono,Consolas,Menlo,monospace</FontFamily>
  <x:Double x:Key="RafFontSizeDisplay">26</x:Double>
  <x:Double x:Key="RafFontSizeTitle">20</x:Double>
  <x:Double x:Key="RafFontSizeHeading">15</x:Double>
  <x:Double x:Key="RafFontSizeBody">13</x:Double>
  <x:Double x:Key="RafFontSizeSmall">12</x:Double>
  <x:Double x:Key="RafFontSizeTiny">10.5</x:Double>
  <CornerRadius x:Key="RafRadiusSmall">4</CornerRadius>
  <CornerRadius x:Key="RafRadius">6</CornerRadius>
  <CornerRadius x:Key="RafRadiusLarge">12</CornerRadius>
  <CornerRadius x:Key="RafRadiusTab">6,6,0,0</CornerRadius>
  <CornerRadius x:Key="RafRadiusPill">999</CornerRadius>

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <!-- Superficies, de la más baja a la más alta -->
      <SolidColorBrush x:Key="RafWindowBrush" Color="#111318" />
      <SolidColorBrush x:Key="RafChromeBrush" Color="#15181E" />
      <SolidColorBrush x:Key="RafSidebarBrush" Color="#15181E" />
      <SolidColorBrush x:Key="RafSurfaceBrush" Color="#1B1E25" />
      <SolidColorBrush x:Key="RafPanelBrush" Color="#171A20" />
      <SolidColorBrush x:Key="RafRaisedBrush" Color="#20242C" />
      <SolidColorBrush x:Key="RafHoverBrush" Color="#262A33" />
      <SolidColorBrush x:Key="RafSelectedBrush" Color="#2B2F45" />
      <SolidColorBrush x:Key="RafInputBrush" Color="#13161B" />
      <SolidColorBrush x:Key="RafInputReadOnlyBrush" Color="#181B21" />
      <SolidColorBrush x:Key="RafBorderBrush" Color="#2A2F38" />
      <SolidColorBrush x:Key="RafBorderStrongBrush" Color="#3A404B" />
      <SolidColorBrush x:Key="RafRowAltBrush" Color="#1E2229" />
      <SolidColorBrush x:Key="RafScrimBrush" Color="#000000" Opacity="0.55" />

      <!-- Texto -->
      <SolidColorBrush x:Key="RafTextBrush" Color="#E7E9EE" />
      <SolidColorBrush x:Key="RafTextSecondaryBrush" Color="#A1A8B5" />
      <SolidColorBrush x:Key="RafTextMutedBrush" Color="#6E7684" />
      <SolidColorBrush x:Key="RafOnAccentBrush" Color="#FFFFFF" />

      <!-- Acento -->
      <SolidColorBrush x:Key="RafAccentBrush" Color="#6366F1" />
      <SolidColorBrush x:Key="RafAccentHoverBrush" Color="#7579F4" />
      <SolidColorBrush x:Key="RafAccentPressedBrush" Color="#5457DB" />
      <SolidColorBrush x:Key="RafAccentTextBrush" Color="#A5A8FF" />
      <SolidColorBrush x:Key="RafAccentSoftBrush" Color="#7B7FF6" Opacity="0.16" />

      <!-- Estados -->
      <SolidColorBrush x:Key="RafSuccessBrush" Color="#3FCF8E" />
      <SolidColorBrush x:Key="RafSuccessSoftBrush" Color="#3FCF8E" Opacity="0.14" />
      <SolidColorBrush x:Key="RafWarningBrush" Color="#F2A93B" />
      <SolidColorBrush x:Key="RafWarningSoftBrush" Color="#F2A93B" Opacity="0.14" />
      <SolidColorBrush x:Key="RafDangerBrush" Color="#F2555A" />
      <SolidColorBrush x:Key="RafDangerSoftBrush" Color="#F2555A" Opacity="0.14" />
      <SolidColorBrush x:Key="RafNeutralBrush" Color="#A1A8B5" />
      <SolidColorBrush x:Key="RafNeutralSoftBrush" Color="#A1A8B5" Opacity="0.14" />

      <!-- Métodos HTTP -->
      <SolidColorBrush x:Key="RafMethodGetBrush" Color="#3FCF8E" />
      <SolidColorBrush x:Key="RafMethodPostBrush" Color="#F2A93B" />
      <SolidColorBrush x:Key="RafMethodPutBrush" Color="#5EA8FF" />
      <SolidColorBrush x:Key="RafMethodPatchBrush" Color="#B58CFF" />
      <SolidColorBrush x:Key="RafMethodDeleteBrush" Color="#F2555A" />
      <SolidColorBrush x:Key="RafMethodHeadBrush" Color="#2CC5C5" />
      <SolidColorBrush x:Key="RafMethodOptionsBrush" Color="#E36FB8" />
      <SolidColorBrush x:Key="RafMethodOtherBrush" Color="#A1A8B5" />

      <!-- Resaltado de sintaxis (JSON y XML) -->
      <SolidColorBrush x:Key="RafSyntaxPropertyBrush" Color="#8FB8FF" />
      <SolidColorBrush x:Key="RafSyntaxStringBrush" Color="#A8D98B" />
      <SolidColorBrush x:Key="RafSyntaxNumberBrush" Color="#F2B56B" />
      <SolidColorBrush x:Key="RafSyntaxKeywordBrush" Color="#D49BFF" />
      <SolidColorBrush x:Key="RafSyntaxTagBrush" Color="#F28B82" />
      <SolidColorBrush x:Key="RafSyntaxCommentBrush" Color="#6E7684" />
      <SolidColorBrush x:Key="RafSyntaxPunctuationBrush" Color="#A1A8B5" />

      <BoxShadows x:Key="RafCardShadow">0 12 32 0 #66000000</BoxShadows>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="RafWindowBrush" Color="#F4F5F8" />
      <SolidColorBrush x:Key="RafChromeBrush" Color="#ECEEF2" />
      <SolidColorBrush x:Key="RafSidebarBrush" Color="#F7F8FA" />
      <SolidColorBrush x:Key="RafSurfaceBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="RafPanelBrush" Color="#F9FAFB" />
      <SolidColorBrush x:Key="RafRaisedBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="RafHoverBrush" Color="#E9EBF0" />
      <SolidColorBrush x:Key="RafSelectedBrush" Color="#E4E3FB" />
      <SolidColorBrush x:Key="RafInputBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="RafInputReadOnlyBrush" Color="#F4F5F8" />
      <SolidColorBrush x:Key="RafBorderBrush" Color="#DADDE3" />
      <SolidColorBrush x:Key="RafBorderStrongBrush" Color="#C4C9D2" />
      <SolidColorBrush x:Key="RafRowAltBrush" Color="#F4F5F8" />
      <SolidColorBrush x:Key="RafScrimBrush" Color="#1A1D24" Opacity="0.35" />

      <SolidColorBrush x:Key="RafTextBrush" Color="#1A1D24" />
      <SolidColorBrush x:Key="RafTextSecondaryBrush" Color="#565E6B" />
      <SolidColorBrush x:Key="RafTextMutedBrush" Color="#8A919D" />
      <SolidColorBrush x:Key="RafOnAccentBrush" Color="#FFFFFF" />

      <SolidColorBrush x:Key="RafAccentBrush" Color="#4F46E5" />
      <SolidColorBrush x:Key="RafAccentHoverBrush" Color="#4338CA" />
      <SolidColorBrush x:Key="RafAccentPressedBrush" Color="#3730A3" />
      <SolidColorBrush x:Key="RafAccentTextBrush" Color="#4338CA" />
      <SolidColorBrush x:Key="RafAccentSoftBrush" Color="#4F46E5" Opacity="0.10" />

      <SolidColorBrush x:Key="RafSuccessBrush" Color="#1A7F4B" />
      <SolidColorBrush x:Key="RafSuccessSoftBrush" Color="#1A7F4B" Opacity="0.10" />
      <SolidColorBrush x:Key="RafWarningBrush" Color="#A3590B" />
      <SolidColorBrush x:Key="RafWarningSoftBrush" Color="#A3590B" Opacity="0.10" />
      <SolidColorBrush x:Key="RafDangerBrush" Color="#C8302F" />
      <SolidColorBrush x:Key="RafDangerSoftBrush" Color="#C8302F" Opacity="0.10" />
      <SolidColorBrush x:Key="RafNeutralBrush" Color="#565E6B" />
      <SolidColorBrush x:Key="RafNeutralSoftBrush" Color="#565E6B" Opacity="0.10" />

      <SolidColorBrush x:Key="RafMethodGetBrush" Color="#1A7F4B" />
      <SolidColorBrush x:Key="RafMethodPostBrush" Color="#A3590B" />
      <SolidColorBrush x:Key="RafMethodPutBrush" Color="#1F6FD1" />
      <SolidColorBrush x:Key="RafMethodPatchBrush" Color="#7A4CD9" />
      <SolidColorBrush x:Key="RafMethodDeleteBrush" Color="#C8302F" />
      <SolidColorBrush x:Key="RafMethodHeadBrush" Color="#0F7F86" />
      <SolidColorBrush x:Key="RafMethodOptionsBrush" Color="#B0377F" />
      <SolidColorBrush x:Key="RafMethodOtherBrush" Color="#565E6B" />

      <SolidColorBrush x:Key="RafSyntaxPropertyBrush" Color="#1F5FB8" />
      <SolidColorBrush x:Key="RafSyntaxStringBrush" Color="#1A7F4B" />
      <SolidColorBrush x:Key="RafSyntaxNumberBrush" Color="#A3590B" />
      <SolidColorBrush x:Key="RafSyntaxKeywordBrush" Color="#7A3ECF" />
      <SolidColorBrush x:Key="RafSyntaxTagBrush" Color="#B42318" />
      <SolidColorBrush x:Key="RafSyntaxCommentBrush" Color="#8A919D" />
      <SolidColorBrush x:Key="RafSyntaxPunctuationBrush" Color="#565E6B" />

      <BoxShadows x:Key="RafCardShadow">0 8 24 0 #1F101828</BoxShadows>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
