<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Raf.Client.Core.Localization"
             xmlns:vm="using:Raf.Client.ViewModels"
             xmlns:views="using:Raf.Client.Views"
             x:Class="Raf.Client.Views.LoginView"
             x:DataType="vm:LoginViewModel">
  <ScrollViewer>
    <Border Classes="card" Width="420" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="14">
        <views:BrandHeader />
        <StackPanel Spacing="4">
          <TextBlock Classes="title" Text="{x:Static l:Texts.LoginV_Title}" />
          <TextBlock Classes="caption mono" Text="{Binding ServerText}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ServerText}" />
        </StackPanel>
        <StackPanel Spacing="6">
          <TextBlock Classes="label" Text="{x:Static l:Texts.V_Email}" />
          <TextBox Text="{Binding Email}" Watermark="{x:Static l:Texts.LoginV_EmailHint}" />
        </StackPanel>
        <StackPanel Spacing="6">
          <TextBlock Classes="label" Text="{x:Static l:Texts.V_Password}" />
          <TextBox Text="{Binding Password}" PasswordChar="•" />
          <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
        <DockPanel Margin="0,4,0,0">
          <Button Classes="link" Content="{x:Static l:Texts.V_ChangeServer}" Command="{Binding ChangeServerCommand}"
                  VerticalAlignment="Center" />
          <Button Classes="accent" Content="{x:Static l:Texts.LoginV_Enter}" IsDefault="True" HorizontalAlignment="Right" MinWidth="110"
                  HorizontalContentAlignment="Center" Command="{Binding LoginCommand}" IsEnabled="{Binding !IsBusy}" />
        </DockPanel>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button Classes="link" Content="{x:Static l:Texts.MainV_Preferences}" Command="{Binding Shell.OpenPreferencesCommand}" />
          <Button Classes="link" Content="{x:Static l:Texts.MainV_About}" Command="{Binding Shell.OpenAboutCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
