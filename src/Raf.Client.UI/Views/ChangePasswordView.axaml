<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Raf.Client.Core.Localization"
             xmlns:vm="using:Raf.Client.ViewModels"
             xmlns:views="using:Raf.Client.Views"
             x:Class="Raf.Client.Views.ChangePasswordView"
             x:DataType="vm:ChangePasswordViewModel">
  <ScrollViewer>
    <Border Classes="card" Width="420" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="14">
        <views:BrandHeader />
        <StackPanel Spacing="4">
          <TextBlock Classes="title" Text="{Binding Heading}" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Intro}" />
        </StackPanel>
        <StackPanel Spacing="6">
          <TextBlock Classes="label" Text="{x:Static l:Texts.PwdV_Current}" />
          <TextBox Text="{Binding Current}" PasswordChar="•" />
        </StackPanel>
        <StackPanel Spacing="6">
          <TextBlock Classes="label" Text="{x:Static l:Texts.PwdV_New}" />
          <TextBox Text="{Binding Next}" Watermark="{x:Static l:Texts.PwdV_MinLength}" PasswordChar="•" />
          <TextBox Text="{Binding Repeat}" Watermark="{x:Static l:Texts.PwdV_Repeat}" PasswordChar="•" />
          <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
          <Button Content="{x:Static l:Texts.V_Cancel}" Command="{Binding CancelCommand}" />
          <Button Classes="accent" Content="{x:Static l:Texts.V_Save}" IsDefault="True" MinWidth="110" HorizontalContentAlignment="Center"
                  Command="{Binding SaveCommand}" IsEnabled="{Binding !IsBusy}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
