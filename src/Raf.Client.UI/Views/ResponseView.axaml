<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Raf.Client.Core.Localization"
             xmlns:vm="using:Raf.Client.ViewModels"
             xmlns:ctl="using:Raf.Client.Controls"
             x:Class="Raf.Client.Views.ResponseView"
             x:DataType="vm:ResponseViewModel">
  <Grid>
    <StackPanel Classes="empty" IsVisible="{Binding ShowPlaceholder}">
      <ctl:Icon Data="{StaticResource IconSend}" />
      <TextBlock Classes="empty-title" Text="{x:Static l:Texts.RespV_None}" />
      <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
        <TextBlock Classes="caption" VerticalAlignment="Center" Text="{x:Static l:Texts.RespV_SendWith}" />
        <Border Classes="kbd"><TextBlock Text="Ctrl+Enter" /></Border>
      </StackPanel>
    </StackPanel>
    <StackPanel Classes="empty" IsVisible="{Binding ShowSending}">
      <TextBlock Classes="empty-title" Text="{x:Static l:Texts.RespV_Sending}" />
    </StackPanel>

    <!-- La respuesta anterior queda visible mientras se envía de nuevo: el layout no salta -->
    <DockPanel IsVisible="{Binding HasResult}" Margin="14,10,14,8">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <CheckBox MinHeight="0" Content="{x:Static l:Texts.RespV_Raw}" IsChecked="{Binding ShowRaw}" IsVisible="{Binding HasBody}" />
          <Button Classes="link" Content="{x:Static l:Texts.RespV_SaveToFile}" Command="{Binding SaveCommand}" IsVisible="{Binding HasBody}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="16">
          <Border Classes="chip" Classes.success="{Binding IsSuccess}" Classes.failure="{Binding IsHttpError}"
                  ToolTip.Tip="{x:Static l:Texts.RespV_StatusTip}">
            <TextBlock Text="{Binding StatusText}" />
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="5" ToolTip.Tip="{x:Static l:Texts.RespV_TimeTip}">
            <ctl:Icon Classes="node" Width="13" Height="13" Data="{StaticResource IconClock}" />
            <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding TimeText}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="5" ToolTip.Tip="{x:Static l:Texts.RespV_SizeTip}"
                      IsVisible="{Binding SizeText, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ctl:Icon Classes="node" Width="13" Height="13" Data="{StaticResource IconSize}" />
            <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding SizeText}" />
          </StackPanel>
        </StackPanel>
      </DockPanel>
      <TextBlock DockPanel.Dock="Top" Classes="error" Margin="0,4,0,0" Text="{Binding ErrorText}"
                 IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock DockPanel.Dock="Top" Classes="warning" Margin="0,4,0,0" Text="{Binding TruncatedText}"
                 IsVisible="{Binding TruncatedText, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TabControl Classes="section" Padding="0,6,0,0">
        <TabItem Header="Body">
          <ctl:TextField x:Name="BodyField" Multiline="True" IsReadOnly="True" HighlightVariables="False"
                         BoundText="{Binding BodyText, Mode=OneWay}" Syntax="{Binding Syntax}">
            <!-- Valor, clave y ruta del nodo de la línea donde se hizo clic derecho (solo JSON o XML válido) -->
            <ctl:TextField.ContextMenu>
              <ContextMenu Opening="OnBodyMenuOpening">
                <MenuItem Header="{x:Static l:Texts.RespV_CopyValue}" Command="{Binding CopyNodeValueCommand}" IsVisible="{Binding IsStructured}" />
                <MenuItem Header="{x:Static l:Texts.RespV_CopyKey}" Command="{Binding CopyNodeKeyCommand}" IsVisible="{Binding IsStructured}" />
                <MenuItem Header="{Binding PathMenuText}" Command="{Binding CopyNodePathCommand}" IsVisible="{Binding IsStructured}" />
                <MenuItem Header="{x:Static l:Texts.Response_SaveToVariable}" Command="{Binding SaveNodeToVariableCommand}" IsVisible="{Binding IsStructured}" />
                <Separator IsVisible="{Binding IsStructured}" />
                <MenuItem Header="{x:Static l:Texts.RespV_CopySelection}" InputGesture="Ctrl+C" Command="{Binding CopySelectionCommand}" />
                <MenuItem Header="{x:Static l:Texts.RespV_CopyLine}" Command="{Binding CopyBodyLineCommand}" />
                <MenuItem Header="{x:Static l:Texts.RespV_CopyBody}" Command="{Binding CopyBodyCommand}" />
              </ContextMenu>
            </ctl:TextField.ContextMenu>
          </ctl:TextField>
        </TabItem>
        <TabItem Header="Headers">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Headers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ResponseHeaderRow">
                  <Border Classes="header-row" Background="Transparent">
                    <Border.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="{x:Static l:Texts.RespV_CopyName}" Command="{Binding CopyNameCommand}" />
                        <MenuItem Header="{x:Static l:Texts.RespV_CopyValue}" Command="{Binding CopyValueCommand}" />
                        <MenuItem Header="{x:Static l:Texts.RespV_CopyHeader}" Command="{Binding CopyLineCommand}" />
                        <MenuItem Header="{x:Static l:Texts.Response_SaveToVariable}" Command="{Binding SaveToVariableCommand}" />
                        <Separator />
                        <MenuItem Header="{x:Static l:Texts.RespV_CopyAllHeaders}" Command="{Binding CopyAllCommand}" />
                      </ContextMenu>
                    </Border.ContextMenu>
                    <Grid ColumnDefinitions="240,*" ColumnSpacing="12">
                      <!-- Sin el menú propio del texto seleccionable: manda el de la fila -->
                      <SelectableTextBlock Classes="header-name mono" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                           ContextFlyout="{x:Null}" />
                      <SelectableTextBlock Grid.Column="1" Classes="mono" TextWrapping="Wrap" Text="{Binding Value}"
                                           ContextFlyout="{x:Null}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="{x:Static l:Texts.RespV_Console}" ToolTip.Tip="{x:Static l:Texts.RespV_ConsoleTip}">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding ConsoleNotice}" />
                <Button Classes="link" Content="{x:Static l:Texts.V_Copy}" Command="{Binding CopyConsoleCommand}"
                        ToolTip.Tip="{x:Static l:Texts.RespV_ConsoleCopyTip}" />
              </StackPanel>
              <TextBlock Classes="caption" VerticalAlignment="Center"
                         Text="{x:Static l:Texts.RespV_ConsoleHint}" />
            </DockPanel>

            <!-- Detalle del evento elegido: request y respuesta en crudo, certificado, causa del error -->
            <Border DockPanel.Dock="Bottom" Height="190" IsVisible="{Binding HasSelectedDetail}"
                    BorderBrush="{DynamicResource RafBorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
              <TextBox Classes="mono" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                       Text="{Binding SelectedEvent.Detail, FallbackValue=''}" />
            </Border>

            <ListBox ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:RunEventRow">
                  <Grid ColumnDefinitions="70,96,*,Auto" ColumnSpacing="10">
                    <TextBlock Classes="caption mono" VerticalAlignment="Top" Margin="0,3,0,0" Text="{Binding At}" />
                    <Border Grid.Column="1" Classes="chip" Classes.warning="{Binding IsWarning}" Classes.failure="{Binding IsError}"
                            HorizontalAlignment="Left" VerticalAlignment="Top">
                      <TextBlock Text="{Binding Stage}" />
                    </Border>
                    <SelectableTextBlock Grid.Column="2" TextWrapping="Wrap" Margin="0,2,0,0" Text="{Binding Title}" />
                    <TextBlock Grid.Column="3" Classes="caption mono" VerticalAlignment="Top" Margin="0,3,0,0"
                               Text="{Binding Duration}" ToolTip.Tip="{x:Static l:Texts.RespV_StageTip}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </TabItem>
      </TabControl>
    </DockPanel>

    <ProgressBar Classes="thin" IsIndeterminate="True" VerticalAlignment="Top" IsVisible="{Binding IsRunning}" />
  </Grid>
</UserControl>
