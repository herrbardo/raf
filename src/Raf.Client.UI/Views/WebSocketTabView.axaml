<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Raf.Client.Core.Localization"
             xmlns:vm="using:Raf.Client.ViewModels"
             xmlns:ctl="using:Raf.Client.Controls"
             xmlns:views="using:Raf.Client.Views"
             x:Class="Raf.Client.Views.WebSocketTabView"
             x:DataType="vm:WebSocketTabViewModel">
  <!-- Ctrl+Enter (en ShellView) conecta, o manda lo escrito si ya hay conexión. -->
  <Grid RowDefinitions="Auto,Auto,*,5,*">
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="14,14,14,0">
      <ctl:MethodBadge Classes="large" Method="WS" Margin="4,0,6,0" ToolTip.Tip="{x:Static l:Texts.WsV_UrlTip}" />
      <ctl:TextField Grid.Column="1" BoundText="{Binding Url}" IsReadOnly="{Binding IsReadOnly}" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
        <Panel>
          <Button Classes="accent primary-action" Command="{Binding ConnectCommand}" IsVisible="{Binding IsDisconnected}"
                  IsEnabled="{Binding IsAvailable}" ToolTip.Tip="{x:Static l:Texts.WsV_ConnectTip}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <ctl:Icon Data="{StaticResource IconSend}" />
              <TextBlock VerticalAlignment="Center" Text="{x:Static l:Texts.WsV_Connect}" />
            </StackPanel>
          </Button>
          <Button Classes="primary-action" Command="{Binding DisconnectCommand}" IsVisible="{Binding !IsDisconnected}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <ctl:Icon Data="{StaticResource IconClose}" />
              <TextBlock VerticalAlignment="Center" Text="{x:Static l:Texts.WsV_Disconnect}" />
            </StackPanel>
          </Button>
        </Panel>
        <Button Command="{Binding SaveCommand}" IsEnabled="{Binding IsDirty}" IsVisible="{Binding CanEdit}" ToolTip.Tip="{x:Static l:Texts.V_SaveTip}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <ctl:Icon Data="{StaticResource IconSave}" />
            <TextBlock VerticalAlignment="Center" Text="{x:Static l:Texts.V_Save}" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1" Margin="14,6,14,0" Spacing="4">
      <TextBlock Classes="warning" TextWrapping="Wrap" Text="{x:Static l:Texts.WsV_DesktopOnly}" IsVisible="{Binding !IsAvailable}" />
      <TextBlock Classes="warning" Text="{Binding Warning}" IsVisible="{Binding Warning, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <TabControl Grid.Row="2" Classes="section" Margin="14,6,14,0" Padding="0,6,0,8">
      <TabItem Header="{x:Static l:Texts.WsV_Messages}">
        <Grid ColumnDefinitions="200,*" ColumnSpacing="12">
          <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0" IsVisible="{Binding CanEdit}">
              <Button Classes="link" Command="{Binding AddMessageCommand}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <ctl:Icon Width="12" Height="12" Data="{StaticResource IconPlus}" />
                  <TextBlock VerticalAlignment="Center" Text="{x:Static l:Texts.V_Add}" />
                </StackPanel>
              </Button>
              <Button Classes="link" Content="{x:Static l:Texts.V_Remove}" Command="{Binding RemoveMessageCommand}"
                      IsEnabled="{Binding HasSelectedMessage}" />
            </StackPanel>
            <Grid>
              <TextBlock Classes="caption" Margin="6,0" TextWrapping="Wrap" Text="{x:Static l:Texts.WsV_NoMessages}"
                         IsVisible="{Binding !Messages.Count}" />
              <ListBox ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:PreparedMessageViewModel">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </DockPanel>
          <DockPanel Grid.Column="1" IsVisible="{Binding HasSelectedMessage}">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,6">
              <TextBox Text="{Binding SelectedMessage.Name}" IsReadOnly="{Binding IsReadOnly}" Watermark="{x:Static l:Texts.V_Name}" />
              <Button Grid.Column="1" Classes="accent" Command="{Binding SendSelectedCommand}" IsEnabled="{Binding IsConnected}"
                      ToolTip.Tip="{x:Static l:Texts.WsV_SendPreparedTip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <ctl:Icon Data="{StaticResource IconSend}" />
                  <TextBlock VerticalAlignment="Center" Text="{x:Static l:Texts.V_Send}" />
                </StackPanel>
              </Button>
            </Grid>
            <ctl:TextField BoundText="{Binding SelectedMessage.Content}" Multiline="True" Syntax="Json" IsReadOnly="{Binding IsReadOnly}" />
          </DockPanel>
        </Grid>
      </TabItem>
      <TabItem Header="Query"><ContentControl Content="{Binding Query}" /></TabItem>
      <TabItem Header="Headers"><ContentControl Content="{Binding Headers}" /></TabItem>
      <TabItem Header="Auth"><ContentControl Content="{Binding Auth}" /></TabItem>
      <TabItem Header="{x:Static l:Texts.V_Options}">
        <StackPanel Spacing="12" Margin="0,4" MaxWidth="460" HorizontalAlignment="Left">
          <StackPanel Spacing="4">
            <TextBlock Text="{x:Static l:Texts.WsV_Subprotocols}" />
            <TextBox Text="{Binding Subprotocols}" IsReadOnly="{Binding IsReadOnly}" Watermark="graphql-ws, v1.chat" />
            <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static l:Texts.WsV_SubprotocolsHint}" />
          </StackPanel>
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static l:Texts.Req_OptionsHint}" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock VerticalAlignment="Center" Text="{x:Static l:Texts.WsV_ConnectTimeout}" />
            <TextBox Width="190" Text="{Binding TimeoutText}" Watermark="{Binding TimeoutHint}" />
          </StackPanel>
          <CheckBox IsChecked="{Binding AcceptInvalidCertificates}" Content="{x:Static l:Texts.V_AcceptInvalidCerts}" />
        </StackPanel>
      </TabItem>
    </TabControl>

    <GridSplitter Grid.Row="3" ResizeDirection="Rows" />
    <Border Grid.Row="4" Classes="panel">
      <DockPanel Margin="14,10,14,10">
        <Border DockPanel.Dock="Top" Classes="chip" Classes.success="{Binding IsConnected}" HorizontalAlignment="Left" Margin="0,0,0,8">
          <TextBlock Text="{Binding StateText}" />
        </Border>
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,8,0,0">
          <ctl:TextField BoundText="{Binding Conversation.Composer}" Multiline="True" Syntax="Json" MaxHeight="120" MinHeight="44" />
          <Button Grid.Column="1" Classes="accent" VerticalAlignment="Bottom" Command="{Binding SendComposerCommand}"
                  IsEnabled="{Binding IsConnected}" ToolTip.Tip="{x:Static l:Texts.WsV_SendTip}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ctl:Icon Data="{StaticResource IconSend}" />
              <TextBlock VerticalAlignment="Center" Text="{x:Static l:Texts.V_Send}" />
            </StackPanel>
          </Button>
        </Grid>
        <views:ConversationView DataContext="{Binding Conversation}" />
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
