<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Raf.Client.Core.Localization"
             xmlns:vm="using:Raf.Client.ViewModels"
             xmlns:views="using:Raf.Client.Views"
             xmlns:ctl="using:Raf.Client.Controls"
             x:Class="Raf.Client.Views.ConnectView"
             x:DataType="vm:ConnectViewModel">
  <ScrollViewer>
    <Border Classes="card" Width="480" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="14">
        <views:BrandHeader />

        <!-- Lista de servidores guardados -->
        <StackPanel Spacing="14" IsVisible="{Binding ShowList}">
          <StackPanel Spacing="4">
            <TextBlock Classes="title" Text="{x:Static l:Texts.ConnV_Title}" />
            <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static l:Texts.ConnV_Intro}" />
          </StackPanel>
          <Border Classes="group" Padding="0">
            <ItemsControl ItemsSource="{Binding Servers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ServerItemViewModel">
                  <Border Padding="12,8">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                      <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding Title}" />
                        <TextBlock Classes="caption mono" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding Subtitle, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="accent" Content="{x:Static l:Texts.ConnV_Connect}" VerticalAlignment="Center"
                              Command="{Binding ConnectCommand}" IsEnabled="{Binding !Owner.IsBusy}" />
                      <Button Grid.Column="2" Classes="icon" VerticalAlignment="Center" ToolTip.Tip="{x:Static l:Texts.ConnV_Edit}"
                              Command="{Binding EditCommand}" IsEnabled="{Binding !Owner.IsBusy}">
                        <ctl:Icon Data="{StaticResource IconEdit}" />
                      </Button>
                      <Button Grid.Column="3" Classes="icon" VerticalAlignment="Center" ToolTip.Tip="{x:Static l:Texts.V_Delete}"
                              Command="{Binding DeleteCommand}" IsEnabled="{Binding !Owner.IsBusy}">
                        <ctl:Icon Data="{StaticResource IconTrash}" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
          <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}"
                     IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <Button Classes="ghost" HorizontalAlignment="Right" Command="{Binding AddCommand}" IsEnabled="{Binding !IsBusy}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ctl:Icon Data="{StaticResource IconPlus}" />
              <TextBlock Text="{x:Static l:Texts.ConnV_Add}" />
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- Alta o edición -->
        <StackPanel Spacing="14" IsVisible="{Binding IsFormOpen}">
          <TextBlock Classes="title" Text="{Binding FormTitle}" />
          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="{x:Static l:Texts.ConnV_NameLabel}" />
            <TextBox Text="{Binding FormName}" Watermark="{x:Static l:Texts.ConnV_NameHint}" />
          </StackPanel>
          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="{x:Static l:Texts.ConnV_UrlLabel}" />
            <TextBox Text="{Binding FormUrl}" Watermark="{x:Static l:Texts.ConnV_UrlHint}" />
            <TextBlock Classes="warning" TextWrapping="Wrap" IsVisible="{Binding InsecureWarning}"
                       Text="{x:Static l:Texts.ConnV_Insecure}" />
            <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding FormError}"
                       IsVisible="{Binding FormError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}"
                       IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{x:Static l:Texts.V_Cancel}" Command="{Binding CancelFormCommand}" IsVisible="{Binding HasServers}"
                    IsCancel="True" IsEnabled="{Binding !IsBusy}" />
            <Button Content="{x:Static l:Texts.V_Save}" Command="{Binding SaveFormCommand}" IsEnabled="{Binding !IsBusy}" />
            <Button Classes="accent" Content="{x:Static l:Texts.ConnV_SaveAndConnect}" IsDefault="True"
                    Command="{Binding SaveAndConnectCommand}" IsEnabled="{Binding !IsBusy}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button Classes="link" Content="{x:Static l:Texts.MainV_Preferences}" Command="{Binding Shell.OpenPreferencesCommand}" />
          <Button Classes="link" Content="{x:Static l:Texts.MainV_About}" Command="{Binding Shell.OpenAboutCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
