<svc:DialogView xmlns:svc="using:Raf.Client.Services" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Raf.Client.Core.Localization"
        xmlns:vm="using:Raf.Client.ViewModels"
        xmlns:ctl="using:Raf.Client.Controls"
        x:Class="Raf.Client.Views.PreferencesDialog"
        x:DataType="vm:PreferencesViewModel"
        Title="{x:Static l:Texts.Prefs_Title}"
        DialogWidth="560" DialogCanResize="False">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="dialog-footer">
      <Button HorizontalAlignment="Right" Classes="accent" IsDefault="True" IsCancel="True"
              Content="{x:Static l:Texts.V_Close}" Click="OnCloseClick" />
    </Border>

    <StackPanel Margin="20,18" Spacing="8">
      <TextBlock Classes="label" Text="{x:Static l:Texts.Prefs_Language}" />
      <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding Language}" />
      <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static l:Texts.Prefs_LanguageHint}" />
      <Border Classes="callout" Margin="0,6,0,0" IsVisible="{Binding NeedsRestart}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ctl:Icon Data="{StaticResource IconWarning}" />
          <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Text="{x:Static l:Texts.Prefs_RestartNeeded}" />
        </StackPanel>
      </Border>

      <!-- Asistente por MCP (Plan 12): solo en la app de escritorio y con sesión iniciada -->
      <StackPanel Spacing="8" Margin="0,14,0,0" IsVisible="{Binding HasMcp}">
        <Separator />
        <TextBlock Classes="label" Text="{x:Static l:Texts.Mcp_Title}" />
        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static l:Texts.Mcp_Hint}" />
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
            <Button Content="{x:Static l:Texts.Mcp_Connect}" Command="{Binding Mcp.ConnectCommand}" IsEnabled="{Binding !Mcp.IsBusy}" />
            <Button Content="{x:Static l:Texts.Mcp_Disconnect}" Command="{Binding Mcp.DisconnectCommand}"
                    IsVisible="{Binding Mcp.IsConnected}" IsEnabled="{Binding !Mcp.IsBusy}" />
          </StackPanel>
          <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Mcp.StatusText}" />
        </DockPanel>
        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static l:Texts.Mcp_OtherServer}" IsVisible="{Binding Mcp.IsOtherServer}" />
        <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Mcp.Error}"
                   IsVisible="{Binding Mcp.Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <TextBlock Classes="label" Margin="0,6,0,0" Text="{x:Static l:Texts.Mcp_Permissions}" />
        <CheckBox IsChecked="{Binding Mcp.CanRead}" Content="{x:Static l:Texts.Mcp_Read}" />
        <CheckBox IsChecked="{Binding Mcp.CanRun}" Content="{x:Static l:Texts.Mcp_Run}" IsEnabled="{Binding Mcp.CanChooseMore}" Margin="20,0,0,0" />
        <CheckBox IsChecked="{Binding Mcp.CanWrite}" Content="{x:Static l:Texts.Mcp_Write}" IsEnabled="{Binding Mcp.CanChooseMore}" Margin="20,0,0,0" />

        <TextBlock Classes="label" Margin="0,6,0,0" Text="{x:Static l:Texts.Mcp_Setup}" />
        <TextBlock Classes="caption" Text="{x:Static l:Texts.Mcp_ClaudeCode}" />
        <TextBox Classes="mono" IsReadOnly="True" TextWrapping="Wrap" Text="{Binding Mcp.ClaudeCodeCommand, Mode=OneWay}" />
        <TextBlock Classes="caption" Text="{x:Static l:Texts.Mcp_VsCode}" />
        <TextBox Classes="mono" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding Mcp.VsCodeConfig, Mode=OneWay}" />
      </StackPanel>
    </StackPanel>
  </DockPanel>
</svc:DialogView>
