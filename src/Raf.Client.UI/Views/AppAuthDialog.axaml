<svc:DialogView xmlns:svc="using:Raf.Client.Services" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Raf.Client.Core.Localization"
        xmlns:vm="using:Raf.Client.ViewModels"
        xmlns:ctl="using:Raf.Client.Controls"
        x:Class="Raf.Client.Views.AppAuthDialog"
        x:DataType="vm:AppAuthViewModel"
        Title="{Binding Title}"
        DialogWidth="640" DialogHeight="520" DialogMinWidth="480" DialogMinHeight="360"
        ctl:VariableHighlight.Lookup="{Binding Lookup}">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="dialog-footer">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="{x:Static l:Texts.V_Cancel}" IsCancel="True" Click="OnCancelClick" IsVisible="{Binding CanEdit}" />
          <Button Classes="accent" Content="{x:Static l:Texts.V_Save}" Click="OnSaveClick" IsVisible="{Binding CanEdit}" />
          <Button Classes="accent" Content="{x:Static l:Texts.V_Close}" IsCancel="True" Click="OnCancelClick" IsVisible="{Binding !CanEdit}" />
        </StackPanel>
      </Grid>
    </Border>

    <TabControl Classes="section" Margin="16,10,16,0" Padding="0,8,0,8">
      <TabItem Header="Auth">
        <StackPanel Spacing="12" Margin="0,4">
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static l:Texts.AppAuth_Hint}" />
          <ContentControl Content="{Binding Auth}" />
        </StackPanel>
      </TabItem>

      <TabItem Header="{x:Static l:Texts.AppLogin_Tab}">
        <StackPanel Spacing="12" Margin="0,4">
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static l:Texts.AppLogin_ChooseHint}" />
          <ComboBox Width="320" ItemsSource="{Binding LoginChoices}" SelectedItem="{Binding SelectedLogin}" IsEnabled="{Binding CanEdit}" />
          <TextBlock Classes="caption mono" TextWrapping="Wrap" Text="{Binding LoginSummary}"
                     IsVisible="{Binding LoginSummary, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Classes="warning" TextWrapping="Wrap" Text="{x:Static l:Texts.AppLogin_IsOff}" IsVisible="{Binding LoginIsOff}" />
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</svc:DialogView>
