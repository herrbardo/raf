<Project Sdk="Microsoft.NET.Sdk">
  <!-- gRPC del cliente de escritorio (Plan 10). Aparte de Raf.Client.Core para que el build web no cargue estas librerías. -->
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Reflection" />
    <!-- Compila .proto sin protoc (etapa 2). Define tipos con los mismos nombres que Google.Protobuf: va con alias. -->
    <PackageReference Include="protobuf-net.Reflection" Aliases="pbnet" />
    <!-- El modelo de tipos con el que protobuf-net serializa los descriptores que compiló. -->
    <PackageReference Include="protobuf-net" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Raf.Client.Grpc.Tests" />
    <Using Include="Raf.Client.Core.Localization" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Raf.Client.Core\Raf.Client.Core.csproj" />
  </ItemGroup>
</Project>
