<Project Sdk="Microsoft.NET.Sdk">
  <!-- App de escritorio: la interfaz está en Raf.Client.UI, compartida con la web. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>RAF</AssemblyName>
    <RootNamespace>Raf.Client</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationIcon>Assets\raf.ico</ApplicationIcon>
    <Title>RAF</Title>
    <Description>Cliente colaborativo para enviar requests HTTP.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- Origen de las actualizaciones: lo pasa el workflow de release. Sin él, la app no busca versiones nuevas. -->
    <AssemblyMetadata Include="RafUpdateUrl" Value="$(RafUpdateUrl)" Condition="'$(RafUpdateUrl)' != ''" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Velopack" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Raf.Client.Core.Localization" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Raf.Client.UI\Raf.Client.UI.csproj" />
  </ItemGroup>
</Project>
