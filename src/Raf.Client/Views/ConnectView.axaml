<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Raf.Client.Core.Localization"
             xmlns:vm="using:Raf.Client.ViewModels"
             xmlns:views="using:Raf.Client.Views"
             x:Class="Raf.Client.Views.ConnectView"
             x:DataType="vm:ConnectViewModel">
  <ScrollViewer>
    <Border Classes="card" Width="440" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="14">
        <views:BrandHeader />
        <StackPanel Spacing="4">
          <TextBlock Classes="title" Text="{x:Static l:Texts.ConnV_Title}" />
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="{x:Static l:Texts.ConnV_Intro}" />
        </StackPanel>
        <StackPanel Spacing="6">
          <TextBlock Classes="label" Text="{x:Static l:Texts.ConnV_UrlLabel}" />
          <AutoCompleteBox Text="{Binding Url}" ItemsSource="{Binding RecentServers}"
                           FilterMode="Contains" MinimumPrefixLength="0" Watermark="{x:Static l:Texts.ConnV_UrlHint}" />
          <TextBlock Classes="warning" IsVisible="{Binding InsecureWarning}"
                     Text="{x:Static l:Texts.ConnV_Insecure}" />
          <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
        <DockPanel>
          <Button Classes="link" Content="{x:Static l:Texts.MainV_Preferences}" Command="{Binding Shell.OpenPreferencesCommand}"
                  VerticalAlignment="Center" />
          <Button Classes="accent" Content="{x:Static l:Texts.ConnV_Continue}" IsDefault="True" HorizontalAlignment="Right" MinWidth="110"
                  HorizontalContentAlignment="Center" Command="{Binding ConnectCommand}" IsEnabled="{Binding !IsBusy}" />
        </DockPanel>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
