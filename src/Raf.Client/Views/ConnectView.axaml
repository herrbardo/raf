<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Raf.Client.ViewModels"
             x:Class="Raf.Client.Views.ConnectView"
             x:DataType="vm:ConnectViewModel">
  <StackPanel Width="440" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
    <TextBlock Classes="title" Text="Conectar con el servidor" />
    <TextBlock Classes="caption" TextWrapping="Wrap"
               Text="Indicá la URL del servidor RAF de tu equipo, incluido el subpath si lo tiene." />
    <TextBox Text="{Binding Url}" Watermark="https://dominio/raf" />
    <TextBlock Classes="warning" IsVisible="{Binding InsecureWarning}"
               Text="Esta URL no usa https: tu contraseña y tus tokens viajarían sin cifrar." />
    <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <Button Classes="accent" Content="Continuar" IsDefault="True" HorizontalAlignment="Right"
            Command="{Binding ConnectCommand}" IsEnabled="{Binding !IsBusy}" />
  </StackPanel>
</UserControl>
