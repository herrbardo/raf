<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Raf.Client.Core.Localization"
             xmlns:vm="using:Raf.Client.ViewModels"
             xmlns:ctl="using:Raf.Client.Controls"
             xmlns:dto="using:Raf.Contracts"
             x:Class="Raf.Client.Views.MainView"
             x:DataType="vm:MainViewModel"
             ctl:VariableHighlight.Lookup="{Binding VariableLookup}">
  <DockPanel>
    <!-- Barra superior: workspace y environment a la izquierda; sincronización y usuario a la derecha -->
    <Border DockPanel.Dock="Top" Classes="chrome" Padding="10,6">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
          <Button Classes="sync" Classes.synced="{Binding IsSynced}" Classes.offline="{Binding IsOffline}"
                  Classes.conflict="{Binding IsInConflict}" VerticalAlignment="Center"
                  ToolTip.Tip="{Binding SyncDetail}" ToolTip.ShowOnDisabled="True"
                  Command="{Binding OpenConflictsCommand}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Ellipse Classes="dot" />
              <TextBlock VerticalAlignment="Center" Text="{Binding SyncText}" />
            </StackPanel>
          </Button>
          <Button Classes="icon" Classes.attention="{Binding Shell.EventConsole.HasUnseenProblems}" VerticalAlignment="Center"
                  ToolTip.Tip="{Binding Shell.EventConsole.OpenTip}" Command="{Binding Shell.OpenEventConsoleCommand}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ctl:Icon Data="{StaticResource IconConsole}" />
              <TextBlock VerticalAlignment="Center" Text="{Binding Shell.EventConsole.UnseenProblems}"
                         IsVisible="{Binding Shell.EventConsole.HasUnseenProblems}" />
            </StackPanel>
          </Button>
          <Button Classes="ghost" ToolTip.Tip="{Binding RoleText}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <ctl:Icon Data="{StaticResource IconUser}" />
              <TextBlock VerticalAlignment="Center" MaxWidth="160" TextTrimming="CharacterEllipsis" Text="{Binding UserText}" />
              <ctl:Icon Width="12" Height="12" Data="{StaticResource IconChevronDown}" />
            </StackPanel>
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="{Binding RoleText}" IsEnabled="False" />
                <Separator />
                <MenuItem Header="{x:Static l:Texts.MainV_Admin}" Command="{Binding OpenAdminCommand}" IsVisible="{Binding IsAdmin}" />
                <MenuItem Header="{x:Static l:Texts.MainV_ChangePassword}" Command="{Binding ChangePasswordCommand}" />
                <MenuItem Header="{x:Static l:Texts.MainV_Preferences}" Command="{Binding Shell.OpenPreferencesCommand}" />
                <MenuItem Header="{x:Static l:Texts.MainV_About}" Command="{Binding Shell.OpenAboutCommand}" />
                <Separator />
                <MenuItem Header="{x:Static l:Texts.MainV_Logout}" Command="{Binding LogoutCommand}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="4">
          <ComboBox MinWidth="180" MaxWidth="260" ItemsSource="{Binding Workspaces}" SelectedItem="{Binding SelectedWorkspace}"
                    PlaceholderText="{x:Static l:Texts.MainV_Workspace}" ToolTip.Tip="{x:Static l:Texts.MainV_Workspace}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="dto:WorkspaceDto">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Classes="icon" ToolTip.Tip="{x:Static l:Texts.MainV_NewWorkspace}" Command="{Binding NewWorkspaceCommand}">
            <ctl:Icon Data="{StaticResource IconPlus}" />
          </Button>
          <Button Classes="icon" ToolTip.Tip="{x:Static l:Texts.MainV_WorkspaceSettings}" Command="{Binding OpenWorkspaceSettingsCommand}">
            <ctl:Icon Data="{StaticResource IconMembers}" />
          </Button>
          <Border Width="1" Height="20" Margin="8,0" Background="{DynamicResource RafBorderBrush}" />
          <ComboBox MinWidth="150" MaxWidth="220" ItemsSource="{Binding Environments}" SelectedItem="{Binding SelectedEnvironment}"
                    PlaceholderText="{x:Static l:Texts.MainV_Environment}" ToolTip.Tip="{x:Static l:Texts.MainV_ActiveEnvironment}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:EnvironmentChoice">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Classes="ghost" ToolTip.Tip="{x:Static l:Texts.EnvW_Title}" Command="{Binding EditEnvironmentsCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ctl:Icon Data="{StaticResource IconVariables}" />
              <TextBlock VerticalAlignment="Center" Text="{x:Static l:Texts.V_Variables}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Classes="statusbar">
      <DockPanel>
        <!-- URL del servidor, visible para cualquier rol, para pasársela a quien quiera conectarse -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" Margin="12,0,0,0"
                    ToolTip.Tip="{x:Static l:Texts.Main_ServerTip}">
          <SelectableTextBlock Classes="caption mono" VerticalAlignment="Center" MaxWidth="360"
                               TextTrimming="CharacterEllipsis" Text="{Binding ServerUrlText}" />
          <Button Classes="icon" Padding="3" VerticalAlignment="Center"
                  ToolTip.Tip="{x:Static l:Texts.Main_CopyServerUrl}" AutomationProperties.Name="{x:Static l:Texts.Main_CopyServerUrl}"
                  Command="{Binding CopyServerUrlCommand}">
            <ctl:Icon Width="12" Height="12" Data="{StaticResource IconCopy}" />
          </Button>
        </StackPanel>
        <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding Status}" TextTrimming="CharacterEllipsis" MinHeight="16" />
      </DockPanel>
    </Border>

    <Grid ColumnDefinitions="300,5,*">
      <!-- Barra lateral -->
      <Border Grid.Column="0" Classes="sidebar">
        <TabControl Classes="section" Padding="0" Margin="6,2,0,0">
          <TabItem Header="{x:Static l:Texts.MainV_Collection}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="2" Margin="0,4,6,4">
                <Button Classes="ghost" ToolTip.Tip="{x:Static l:Texts.MainV_NewApp}" Command="{Binding NewAppCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <ctl:Icon Data="{StaticResource IconPlus}" />
                    <TextBlock VerticalAlignment="Center" Text="{x:Static l:Texts.MainV_App}" />
                  </StackPanel>
                </Button>
                <Button Classes="icon" ToolTip.Tip="{x:Static l:Texts.V_Refresh}" Command="{Binding RefreshCommand}">
                  <ctl:Icon Data="{StaticResource IconRefresh}" />
                </Button>
              </StackPanel>
              <Grid>
                <StackPanel Classes="empty" IsVisible="{Binding !Roots.Count}">
                  <ctl:Icon Data="{StaticResource IconFolder}" />
                  <TextBlock Classes="empty-title" Text="{x:Static l:Texts.MainV_EmptyCollection}" />
                  <TextBlock Classes="caption" Text="{x:Static l:Texts.MainV_EmptyCollectionHint}" IsVisible="{Binding CanEdit}" />
                </StackPanel>
                <TreeView ItemsSource="{Binding Roots}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <TreeView.Styles>
                    <Style Selector="TreeViewItem" x:DataType="vm:TreeNodeViewModel">
                      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </Style>
                  </TreeView.Styles>
                  <TreeView.ItemTemplate>
                    <TreeDataTemplate x:DataType="vm:TreeNodeViewModel" ItemsSource="{Binding Children}">
                      <Grid ColumnDefinitions="Auto,*" Background="Transparent" Tapped="OnNodeTapped">
                        <Grid.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="{x:Static l:Texts.MainV_NewFolder}" Command="{Binding NewFolderCommand}" IsVisible="{Binding CanAddContainer}" />
                            <MenuItem Header="{x:Static l:Texts.MainV_NewRequest}" Command="{Binding NewRequestCommand}" IsVisible="{Binding CanAddContainer}" />
                            <MenuItem Header="{x:Static l:Texts.MainV_NewSample}" Command="{Binding NewSampleCommand}" IsVisible="{Binding CanAddSample}" />
                            <MenuItem Header="{x:Static l:Texts.V_Rename}" Command="{Binding RenameCommand}" IsVisible="{Binding CanEdit}" />
                            <MenuItem Header="{x:Static l:Texts.MainV_MoveUp}" Command="{Binding MoveUpCommand}" IsVisible="{Binding CanEdit}" />
                            <MenuItem Header="{x:Static l:Texts.MainV_MoveDown}" Command="{Binding MoveDownCommand}" IsVisible="{Binding CanEdit}" />
                            <MenuItem Header="{x:Static l:Texts.V_Delete}" Command="{Binding DeleteCommand}" IsVisible="{Binding CanEdit}" />
                          </ContextMenu>
                        </Grid.ContextMenu>
                        <Panel Margin="0,0,8,0">
                          <ctl:Icon Classes="node" Data="{StaticResource IconApp}" IsVisible="{Binding IsApp}" />
                          <ctl:Icon Classes="node" Data="{StaticResource IconFolder}" IsVisible="{Binding IsFolder}" />
                          <ctl:MethodBadge Width="44" Method="{Binding Method}" IsVisible="{Binding IsRequest}" />
                          <ctl:Icon Classes="node" Width="14" Height="14" Data="{StaticResource IconSample}" IsVisible="{Binding IsSample}" />
                        </Panel>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Text="{Binding Name}" ToolTip.Tip="{Binding Name}" />
                      </Grid>
                    </TreeDataTemplate>
                  </TreeView.ItemTemplate>
                </TreeView>
              </Grid>
            </DockPanel>
          </TabItem>
          <TabItem Header="{x:Static l:Texts.MainV_History}">
            <Grid>
              <StackPanel Classes="empty" IsVisible="{Binding !History.Count}">
                <ctl:Icon Data="{StaticResource IconHistory}" />
                <TextBlock Classes="empty-title" Text="{x:Static l:Texts.MainV_NoHistory}" />
                <TextBlock Classes="caption" Text="{x:Static l:Texts.MainV_NoHistoryHint}" />
              </StackPanel>
              <ListBox ItemsSource="{Binding History}" Tapped="OnHistoryTapped" Margin="0,4,0,0"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:HistoryRow">
                    <StackPanel Spacing="2">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <ctl:MethodBadge Method="{Binding Method}" MaxWidth="60" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      </Grid>
                      <TextBlock Classes="caption mono" Text="{Binding Url}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="caption" Text="{Binding Result}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </TabItem>
        </TabControl>
      </Border>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

      <!-- Área de edición -->
      <Grid Grid.Column="2">
        <Border Classes="surface" IsVisible="{Binding !Tabs.Count}">
          <StackPanel Classes="empty">
            <ctl:Icon Data="{StaticResource IconLayers}" />
            <TextBlock Classes="empty-title" Text="{x:Static l:Texts.MainV_NoTabs}" />
            <TextBlock Classes="caption" Text="{x:Static l:Texts.MainV_NoTabsHint}" />
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Margin="0,6,0,0">
              <Border Classes="kbd"><TextBlock Text="Ctrl+Enter" /></Border>
              <TextBlock Classes="caption" VerticalAlignment="Center" Text="{x:Static l:Texts.MainV_Sends}" />
              <Border Classes="kbd" Margin="10,0,0,0"><TextBlock Text="Ctrl+S" /></Border>
              <TextBlock Classes="caption" VerticalAlignment="Center" Text="{x:Static l:Texts.MainV_Saves}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <TabControl Classes="documents" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                    IsVisible="{Binding !!Tabs.Count}">
          <TabControl.ItemTemplate>
            <DataTemplate x:DataType="vm:EditorTabViewModel">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto" MaxWidth="230" ToolTip.Tip="{Binding Node.Name}">
                <ctl:MethodBadge Method="{Binding Node.Method}" IsVisible="{Binding Node.IsRequest}" MaxWidth="56" Margin="0,0,7,0" />
                <ctl:Icon Classes="node" Width="13" Height="13" Margin="0,0,7,0" Data="{StaticResource IconSample}" IsVisible="{Binding Node.IsSample}" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Node.Name}" />
                <Ellipse Grid.Column="2" Classes="dirty" Margin="7,0,0,0" ToolTip.Tip="{x:Static l:Texts.V_Unsaved}" IsVisible="{Binding IsDirty}" />
                <Button Grid.Column="3" Classes="icon small tab-close" Margin="4,0,0,0" ToolTip.Tip="{x:Static l:Texts.V_Close}" Command="{Binding CloseCommand}">
                  <ctl:Icon Data="{StaticResource IconClose}" />
                </Button>
              </Grid>
            </DataTemplate>
          </TabControl.ItemTemplate>
        </TabControl>
      </Grid>
    </Grid>
  </DockPanel>
</UserControl>
