<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Raf.Client.ViewModels"
             xmlns:ctl="using:Raf.Client.Controls"
             xmlns:dto="using:Raf.Contracts"
             x:Class="Raf.Client.Views.MainView"
             x:DataType="vm:MainViewModel"
             ctl:VariableHighlight.Lookup="{Binding VariableLookup}">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="10,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource TextControlBorderBrush}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button Classes="link" VerticalAlignment="Center" Content="{Binding SyncText}" Foreground="{Binding SyncBrush}"
                  ToolTip.Tip="Estado de la sincronización. Con conflictos, abre la pantalla para resolverlos."
                  Command="{Binding OpenConflictsCommand}" />
          <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding RoleText}" />
          <Button Content="{Binding UserText}">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Cambiar contraseña" Command="{Binding ChangePasswordCommand}" />
                <MenuItem Header="Cerrar sesión" Command="{Binding LogoutCommand}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ComboBox MinWidth="200" ItemsSource="{Binding Workspaces}" SelectedItem="{Binding SelectedWorkspace}"
                    PlaceholderText="Workspace">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="dto:WorkspaceDto"><TextBlock Text="{Binding Name}" /></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="+" ToolTip.Tip="Nuevo workspace" Command="{Binding NewWorkspaceCommand}" />
          <ComboBox MinWidth="170" ItemsSource="{Binding Environments}" SelectedItem="{Binding SelectedEnvironment}"
                    PlaceholderText="Environment">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:EnvironmentChoice"><TextBlock Text="{Binding Name}" /></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="Variables" Command="{Binding EditEnvironmentsCommand}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="10,4">
      <TextBlock Classes="caption" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
    </Border>

    <Grid ColumnDefinitions="300,4,*">
      <TabControl Grid.Column="0" Padding="0">
        <TabItem Header="Colección" FontSize="14">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="6">
              <Button Content="+ App" Command="{Binding NewAppCommand}" />
              <Button Content="Actualizar" Command="{Binding RefreshCommand}" />
            </StackPanel>
            <TreeView ItemsSource="{Binding Roots}">
              <TreeView.Styles>
                <Style Selector="TreeViewItem" x:DataType="vm:TreeNodeViewModel">
                  <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                </Style>
              </TreeView.Styles>
              <TreeView.ItemTemplate>
                <TreeDataTemplate x:DataType="vm:TreeNodeViewModel" ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent" Tapped="OnNodeTapped">
                    <StackPanel.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Nueva carpeta" Command="{Binding NewFolderCommand}" IsVisible="{Binding CanAddContainer}" />
                        <MenuItem Header="Nuevo request" Command="{Binding NewRequestCommand}" IsVisible="{Binding CanAddContainer}" />
                        <MenuItem Header="Nuevo sample" Command="{Binding NewSampleCommand}" IsVisible="{Binding CanAddSample}" />
                        <MenuItem Header="Renombrar" Command="{Binding RenameCommand}" IsVisible="{Binding CanEdit}" />
                        <MenuItem Header="Subir" Command="{Binding MoveUpCommand}" IsVisible="{Binding CanEdit}" />
                        <MenuItem Header="Bajar" Command="{Binding MoveDownCommand}" IsVisible="{Binding CanEdit}" />
                        <MenuItem Header="Eliminar" Command="{Binding DeleteCommand}" IsVisible="{Binding CanEdit}" />
                      </ContextMenu>
                    </StackPanel.ContextMenu>
                    <TextBlock Classes="caption" FontSize="11" VerticalAlignment="Center" Text="{Binding Badge}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                  </StackPanel>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
          </DockPanel>
        </TabItem>
        <TabItem Header="Historial" FontSize="14">
          <ListBox ItemsSource="{Binding History}" Tapped="OnHistoryTapped">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:HistoryRow">
                <StackPanel Spacing="1">
                  <TextBlock FontSize="13" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="caption" Text="{Binding Url}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="caption" Text="{Binding Result}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </TabItem>
      </TabControl>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

      <Grid Grid.Column="2">
        <TextBlock Classes="caption" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Text="Elegí un request del árbol para empezar."
                   IsVisible="{Binding !Tabs.Count}" />
        <TabControl ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" Padding="0">
          <TabControl.ItemTemplate>
            <DataTemplate x:DataType="vm:EditorTabViewModel">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock FontSize="13" VerticalAlignment="Center" MaxWidth="170" TextTrimming="CharacterEllipsis" Text="{Binding Node.Name}" />
                <TextBlock Foreground="#D9822B" VerticalAlignment="Center" Text="●" ToolTip.Tip="Cambios sin guardar" IsVisible="{Binding IsDirty}" />
                <Button Classes="link" Content="✕" Command="{Binding CloseCommand}" />
              </StackPanel>
            </DataTemplate>
          </TabControl.ItemTemplate>
        </TabControl>
      </Grid>
    </Grid>
  </DockPanel>
</UserControl>
