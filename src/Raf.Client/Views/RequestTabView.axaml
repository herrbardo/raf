<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Raf.Client.Core.Localization"
             xmlns:vm="using:Raf.Client.ViewModels"
             xmlns:ctl="using:Raf.Client.Controls"
             x:Class="Raf.Client.Views.RequestTabView"
             x:DataType="vm:RequestTabViewModel">
  <!-- Ctrl+S y Ctrl+Enter están en MainWindow: así funcionan aunque el foco no esté dentro de la pestaña -->
  <Grid RowDefinitions="Auto,Auto,*,5,*">
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="14,14,14,0">
      <ComboBox Width="124" ItemsSource="{Binding AvailableMethods}" SelectedItem="{Binding Method}"
                IsEnabled="{Binding CanEdit}" ToolTip.Tip="{x:Static l:Texts.Req_Method}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="x:String"><ctl:MethodBadge Classes="large" Method="{Binding}" /></DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <ctl:TextField Grid.Column="1" BoundText="{Binding Url}" IsReadOnly="{Binding IsReadOnly}" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
        <Panel>
          <Button Classes="accent primary-action" Command="{Binding SendCommand}" IsVisible="{Binding !IsRunning}"
                  ToolTip.Tip="{x:Static l:Texts.V_SendTip}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <ctl:Icon Data="{StaticResource IconSend}" />
              <TextBlock VerticalAlignment="Center" Text="{x:Static l:Texts.V_Send}" />
            </StackPanel>
          </Button>
          <Button Classes="primary-action" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <ctl:Icon Data="{StaticResource IconClose}" />
              <TextBlock VerticalAlignment="Center" Text="{x:Static l:Texts.V_Cancel}" />
            </StackPanel>
          </Button>
        </Panel>
        <Button Command="{Binding SaveCommand}" IsEnabled="{Binding IsDirty}" IsVisible="{Binding CanEdit}" ToolTip.Tip="{x:Static l:Texts.V_SaveTip}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <ctl:Icon Data="{StaticResource IconSave}" />
            <TextBlock VerticalAlignment="Center" Text="{x:Static l:Texts.V_Save}" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
    <TextBlock Grid.Row="1" Classes="warning" Margin="14,6,14,0" Text="{Binding Warning}"
               IsVisible="{Binding Warning, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <TabControl Grid.Row="2" Classes="section" Margin="14,6,14,0" Padding="0,6,0,8">
      <TabItem Header="Query"><ContentControl Content="{Binding Query}" /></TabItem>
      <TabItem Header="Headers"><ContentControl Content="{Binding Headers}" /></TabItem>
      <TabItem Header="Body"><ContentControl Content="{Binding Body}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" /></TabItem>
      <TabItem Header="Auth"><ContentControl Content="{Binding Auth}" /></TabItem>
      <TabItem Header="{x:Static l:Texts.V_Options}">
        <StackPanel Spacing="12" Margin="0,4" MaxWidth="460" HorizontalAlignment="Left">
          <TextBlock Classes="caption" Text="{x:Static l:Texts.Req_OptionsHint}" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock VerticalAlignment="Center" Text="{x:Static l:Texts.V_Timeout}" />
            <TextBox Width="190" Text="{Binding TimeoutText}" Watermark="{Binding TimeoutHint}" />
          </StackPanel>
          <CheckBox IsChecked="{Binding AcceptInvalidCertificates}" Content="{x:Static l:Texts.V_AcceptInvalidCerts}" />
        </StackPanel>
      </TabItem>
    </TabControl>

    <GridSplitter Grid.Row="3" ResizeDirection="Rows" />
    <Border Grid.Row="4" Classes="panel">
      <ContentControl Content="{Binding Response}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Border>
  </Grid>
</UserControl>
