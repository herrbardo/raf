<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Raf.Client.ViewModels"
        x:Class="Raf.Client.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="RAF — Requests and Friends"
        Icon="avares://RAF/Assets/raf.png"
        Width="1280" Height="800" MinWidth="900" MinHeight="560">
  <!-- Atajos de la pestaña activa. Van en la ventana porque el foco puede quedar fuera de la pestaña
       (por ejemplo, después de Enviar el botón se deshabilita y el foco vuelve a la ventana). -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding Main.SelectedTab.SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding Main.SelectedTab.SendCommand}" />
    <!-- La consola se abre desde cualquier pantalla, también antes de iniciar sesión. -->
    <KeyBinding Gesture="Ctrl+Shift+L" Command="{Binding OpenEventConsoleCommand}" />
  </Window.KeyBindings>
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="update-banner" Padding="12,6"
            IsVisible="{Binding Updates.IsReady}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="accent" Content="Reiniciar para actualizar"
                Command="{Binding RestartToUpdateCommand}" />
        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
          <Run Text="{Binding Updates.ReadyText}" />
          <Run Classes="caption" Text=" Si no reiniciás ahora, se instala la próxima vez que abras la app." />
        </TextBlock>
      </DockPanel>
    </Border>
    <ContentControl Content="{Binding Page}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
  </DockPanel>
</Window>
