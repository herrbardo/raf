<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Raf.Client.ViewModels"
        xmlns:ctl="using:Raf.Client.Controls"
        x:Class="Raf.Client.Views.EnvironmentsWindow"
        x:DataType="vm:EnvironmentsViewModel"
        Title="Environments y variables"
        Width="860" Height="560" MinWidth="640" MinHeight="360"
        WindowStartupLocation="CenterOwner">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
  </Window.KeyBindings>
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="dialog-footer">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="accent" Content="Guardar" Command="{Binding SaveCommand}" IsVisible="{Binding CanEdit}" IsEnabled="{Binding !IsBusy}"
                  ToolTip.Tip="Guardar (Ctrl+S)" />
          <Button Content="Cerrar" Click="OnCloseClick" />
        </StackPanel>
        <TextBlock Classes="error" VerticalAlignment="Center" Margin="0,0,12,0" Text="{Binding Error}"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Border Classes="chip success" HorizontalAlignment="Left" Margin="0,0,12,0"
                IsVisible="{Binding SavedMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ctl:Icon Width="12" Height="12" Data="{StaticResource IconCheck}" />
            <TextBlock VerticalAlignment="Center" Text="{Binding SavedMessage}" />
          </StackPanel>
        </Border>
      </DockPanel>
    </Border>

    <Grid ColumnDefinitions="220,*">
      <Border Classes="sidebar" BorderBrush="{DynamicResource RafBorderBrush}" BorderThickness="0,0,1,0">
        <DockPanel Margin="10,14,8,10">
          <TextBlock DockPanel.Dock="Top" Classes="label" Margin="6,0,0,8" Text="ALCANCE" />
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="2" Margin="0,8,0,0" IsVisible="{Binding CanEdit}">
            <Button Classes="link" Command="{Binding AddEnvironmentCommand}">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <ctl:Icon Width="12" Height="12" Data="{StaticResource IconPlus}" />
                <TextBlock VerticalAlignment="Center" Text="Nuevo" />
              </StackPanel>
            </Button>
            <Button Classes="link" Content="Renombrar" Command="{Binding RenameEnvironmentCommand}" />
            <Button Classes="link" Content="Eliminar" Command="{Binding DeleteEnvironmentCommand}" />
          </StackPanel>
          <ListBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding SelectedScope}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:VariableScopeViewModel">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <DockPanel Grid.Column="1" Margin="20,14,6,10">
        <Button DockPanel.Dock="Bottom" Classes="link" Margin="0,8,0,0" HorizontalAlignment="Left"
                Command="{Binding AddVariableCommand}" IsVisible="{Binding CanEdit}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <ctl:Icon Width="12" Height="12" Data="{StaticResource IconPlus}" />
            <TextBlock VerticalAlignment="Center" Text="Agregar variable" />
          </StackPanel>
        </Button>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="10,*,2*,70,70,30" ColumnSpacing="6" Margin="0,0,14,6">
          <TextBlock Grid.Column="1" Classes="label" Text="CLAVE" />
          <TextBlock Grid.Column="2" Classes="label" Text="VALOR" />
          <TextBlock Grid.Column="3" Classes="label" Text="SECRETA" />
        </Grid>
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding SelectedScope.Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:VariableRowViewModel">
                <Grid ColumnDefinitions="10,*,2*,70,70,30" ColumnSpacing="6" Margin="0,2,14,2">
                  <Ellipse Classes="dirty" ToolTip.Tip="Cambios sin guardar" IsVisible="{Binding HasChanges}" />
                  <TextBox Grid.Column="1" Classes="mono" Text="{Binding Key}" IsReadOnly="{Binding IsReadOnly}" />
                  <TextBox Grid.Column="2" Classes="mono" Text="{Binding Value}" PasswordChar="{Binding MaskChar}"
                           Watermark="{Binding ValueHint}" IsReadOnly="{Binding IsReadOnly}" />
                  <CheckBox Grid.Column="3" IsChecked="{Binding IsSecret}" IsEnabled="{Binding CanEdit}" ToolTip.Tip="Secreta: se guarda cifrada y se muestra oculta" />
                  <ToggleButton Grid.Column="4" Content="Ver" IsChecked="{Binding Reveal}" IsVisible="{Binding CanReveal}" />
                  <Button Grid.Column="5" Classes="icon small danger" ToolTip.Tip="Quitar" Command="{Binding RemoveCommand}" IsVisible="{Binding CanEdit}">
                    <ctl:Icon Data="{StaticResource IconClose}" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
