<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Raf.Client.ViewModels"
             xmlns:ctl="using:Raf.Client.Controls"
             x:Class="Raf.Client.Views.SampleTabView"
             x:DataType="vm:SampleTabViewModel">
  <!-- Ctrl+S y Ctrl+Enter están en MainWindow: así funcionan aunque el foco no esté dentro de la pestaña -->
  <Grid RowDefinitions="Auto,Auto,*,5,*">
    <StackPanel Spacing="8" Margin="14,14,14,0">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
        <ctl:Icon Classes="node" Data="{StaticResource IconSample}" />
        <TextBlock Grid.Column="1" Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap"
                   Text="Sample: lo que no sobreescribas se hereda del request." />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
          <Panel>
            <Button Classes="accent primary-action" Command="{Binding SendCommand}" IsVisible="{Binding !IsRunning}"
                    ToolTip.Tip="Enviar (Ctrl+Enter)">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <ctl:Icon Data="{StaticResource IconSend}" />
                <TextBlock VerticalAlignment="Center" Text="Enviar" />
              </StackPanel>
            </Button>
            <Button Classes="primary-action" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <ctl:Icon Data="{StaticResource IconClose}" />
                <TextBlock VerticalAlignment="Center" Text="Cancelar" />
              </StackPanel>
            </Button>
          </Panel>
          <Button Command="{Binding SaveCommand}" IsEnabled="{Binding IsDirty}" IsVisible="{Binding CanEdit}" ToolTip.Tip="Guardar (Ctrl+S)">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <ctl:Icon Data="{StaticResource IconSave}" />
              <TextBlock VerticalAlignment="Center" Text="Guardar" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <Grid ColumnDefinitions="70,*,Auto" ColumnSpacing="8">
        <TextBlock Classes="label" VerticalAlignment="Center" Text="Método" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding MethodInherited}">
          <ctl:MethodBadge Classes="large" Method="{Binding InheritedMethod}" />
          <TextBlock Classes="caption" VerticalAlignment="Center" Text="heredado" />
        </StackPanel>
        <ComboBox Grid.Column="1" Width="124" IsVisible="{Binding MethodOverridden}" ItemsSource="{Binding AvailableMethods}" SelectedItem="{Binding Method}" IsEnabled="{Binding CanEdit}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="x:String"><ctl:MethodBadge Classes="large" Method="{Binding}" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Grid.Column="2" Classes="link" Content="Sobreescribir" Command="{Binding OverrideMethodCommand}">
          <Button.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="MethodInherited" /><Binding Path="CanEdit" /></MultiBinding></Button.IsVisible>
        </Button>
        <Button Grid.Column="2" Classes="link" Content="Volver a heredar" Command="{Binding InheritMethodCommand}">
          <Button.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="MethodOverridden" /><Binding Path="CanEdit" /></MultiBinding></Button.IsVisible>
        </Button>
      </Grid>

      <Grid ColumnDefinitions="70,*,Auto" ColumnSpacing="8">
        <TextBlock Classes="label" VerticalAlignment="Center" Text="URL" />
        <TextBlock Grid.Column="1" Classes="mono" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsVisible="{Binding UrlInherited}"
                   Text="{Binding InheritedUrl}" ToolTip.Tip="{Binding InheritedUrl}" />
        <ctl:TextField Grid.Column="1" IsVisible="{Binding UrlOverridden}" BoundText="{Binding Url}" IsReadOnly="{Binding IsReadOnly}" />
        <Button Grid.Column="2" Classes="link" Content="Sobreescribir" Command="{Binding OverrideUrlCommand}">
          <Button.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="UrlInherited" /><Binding Path="CanEdit" /></MultiBinding></Button.IsVisible>
        </Button>
        <Button Grid.Column="2" Classes="link" Content="Volver a heredar" Command="{Binding InheritUrlCommand}">
          <Button.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="UrlOverridden" /><Binding Path="CanEdit" /></MultiBinding></Button.IsVisible>
        </Button>
      </Grid>
    </StackPanel>

    <TextBlock Grid.Row="1" Classes="warning" Margin="14,6,14,0" Text="{Binding Warning}"
               IsVisible="{Binding Warning, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <TabControl Grid.Row="2" Classes="section" Margin="14,6,14,0" Padding="0,6,0,8">
      <TabItem Header="Query"><ContentControl Content="{Binding Query}" /></TabItem>
      <TabItem Header="Headers"><ContentControl Content="{Binding Headers}" /></TabItem>
      <TabItem Header="Body">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,4">
            <Button Classes="link" Content="Sobreescribir" Command="{Binding OverrideBodyCommand}">
              <Button.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="BodyInherited" /><Binding Path="CanEdit" /></MultiBinding></Button.IsVisible>
            </Button>
            <Button Classes="link" Content="Volver a heredar" Command="{Binding InheritBodyCommand}">
              <Button.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="BodyOverridden" /><Binding Path="CanEdit" /></MultiBinding></Button.IsVisible>
            </Button>
          </StackPanel>
          <Grid>
            <ScrollViewer IsVisible="{Binding BodyInherited}">
              <SelectableTextBlock Classes="mono caption" TextWrapping="Wrap" Text="{Binding InheritedBody}" />
            </ScrollViewer>
            <ContentControl Content="{Binding Body}" IsVisible="{Binding BodyOverridden}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
          </Grid>
        </DockPanel>
      </TabItem>
      <TabItem Header="Auth">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,4">
            <Button Classes="link" Content="Sobreescribir" Command="{Binding OverrideAuthCommand}">
              <Button.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="AuthInherited" /><Binding Path="CanEdit" /></MultiBinding></Button.IsVisible>
            </Button>
            <Button Classes="link" Content="Volver a heredar" Command="{Binding InheritAuthCommand}">
              <Button.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="AuthOverridden" /><Binding Path="CanEdit" /></MultiBinding></Button.IsVisible>
            </Button>
          </StackPanel>
          <Grid>
            <TextBlock Classes="caption" IsVisible="{Binding AuthInherited}" Text="{Binding InheritedAuth}" />
            <ContentControl Content="{Binding Auth}" IsVisible="{Binding AuthOverridden}" />
          </Grid>
        </DockPanel>
      </TabItem>
      <TabItem Header="Opciones">
        <StackPanel Spacing="12" Margin="0,4" MaxWidth="460" HorizontalAlignment="Left">
          <TextBlock Classes="caption" Text="Se comparten con el request y se guardan solo en este equipo." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock VerticalAlignment="Center" Text="Timeout (segundos)" />
            <TextBox Width="190" Text="{Binding TimeoutText}" Watermark="{Binding TimeoutHint}" />
          </StackPanel>
          <CheckBox IsChecked="{Binding AcceptInvalidCertificates}" Content="Aceptar certificados inválidos (APIs internas)" />
        </StackPanel>
      </TabItem>
    </TabControl>

    <GridSplitter Grid.Row="3" ResizeDirection="Rows" />
    <Border Grid.Row="4" Classes="panel">
      <ContentControl Content="{Binding Response}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Border>
  </Grid>
</UserControl>
