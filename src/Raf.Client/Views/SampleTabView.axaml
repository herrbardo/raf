<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Raf.Client.ViewModels"
             xmlns:ctl="using:Raf.Client.Controls"
             x:Class="Raf.Client.Views.SampleTabView"
             x:DataType="vm:SampleTabViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SendCommand}" />
  </UserControl.KeyBindings>
  <Grid RowDefinitions="Auto,Auto,*,4,*" Margin="10">
    <StackPanel Spacing="6">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBlock Classes="caption" VerticalAlignment="Center" Text="Sample: lo que no sobreescribas se hereda del request." />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <Button Classes="accent" Content="Enviar" Command="{Binding SendCommand}" IsVisible="{Binding !IsRunning}" />
          <Button Content="Cancelar" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" />
          <Button Content="Guardar" Command="{Binding SaveCommand}" IsEnabled="{Binding IsDirty}" IsVisible="{Binding CanEdit}" />
        </StackPanel>
      </Grid>

      <Grid ColumnDefinitions="70,*,Auto" ColumnSpacing="8">
        <TextBlock VerticalAlignment="Center" Text="Método" />
        <TextBlock Grid.Column="1" VerticalAlignment="Center" IsVisible="{Binding MethodInherited}" Text="{Binding InheritedMethod}" />
        <ComboBox Grid.Column="1" Width="130" IsVisible="{Binding MethodOverridden}" ItemsSource="{Binding AvailableMethods}" SelectedItem="{Binding Method}" IsEnabled="{Binding CanEdit}" />
        <Button Grid.Column="2" Classes="link" Content="Sobreescribir" Command="{Binding OverrideMethodCommand}">
          <Button.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="MethodInherited" /><Binding Path="CanEdit" /></MultiBinding></Button.IsVisible>
        </Button>
        <Button Grid.Column="2" Classes="link" Content="Volver a heredar" Command="{Binding InheritMethodCommand}">
          <Button.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="MethodOverridden" /><Binding Path="CanEdit" /></MultiBinding></Button.IsVisible>
        </Button>
      </Grid>

      <Grid ColumnDefinitions="70,*,Auto" ColumnSpacing="8">
        <TextBlock VerticalAlignment="Center" Text="URL" />
        <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsVisible="{Binding UrlInherited}" Text="{Binding InheritedUrl}" />
        <ctl:TextField Grid.Column="1" IsVisible="{Binding UrlOverridden}" BoundText="{Binding Url}" IsReadOnly="{Binding IsReadOnly}" />
        <Button Grid.Column="2" Classes="link" Content="Sobreescribir" Command="{Binding OverrideUrlCommand}">
          <Button.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="UrlInherited" /><Binding Path="CanEdit" /></MultiBinding></Button.IsVisible>
        </Button>
        <Button Grid.Column="2" Classes="link" Content="Volver a heredar" Command="{Binding InheritUrlCommand}">
          <Button.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="UrlOverridden" /><Binding Path="CanEdit" /></MultiBinding></Button.IsVisible>
        </Button>
      </Grid>
    </StackPanel>

    <TextBlock Grid.Row="1" Classes="warning" Margin="0,6,0,0" Text="{Binding Warning}"
               IsVisible="{Binding Warning, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <TabControl Grid.Row="2" Padding="0,4,0,0">
      <TabItem Header="Query" FontSize="14"><ContentControl Content="{Binding Query}" /></TabItem>
      <TabItem Header="Headers" FontSize="14"><ContentControl Content="{Binding Headers}" /></TabItem>
      <TabItem Header="Body" FontSize="14">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,4">
            <Button Classes="link" Content="Sobreescribir" Command="{Binding OverrideBodyCommand}">
              <Button.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="BodyInherited" /><Binding Path="CanEdit" /></MultiBinding></Button.IsVisible>
            </Button>
            <Button Classes="link" Content="Volver a heredar" Command="{Binding InheritBodyCommand}">
              <Button.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="BodyOverridden" /><Binding Path="CanEdit" /></MultiBinding></Button.IsVisible>
            </Button>
          </StackPanel>
          <Grid>
            <ScrollViewer IsVisible="{Binding BodyInherited}">
              <SelectableTextBlock TextWrapping="Wrap" Text="{Binding InheritedBody}" />
            </ScrollViewer>
            <ContentControl Content="{Binding Body}" IsVisible="{Binding BodyOverridden}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
          </Grid>
        </DockPanel>
      </TabItem>
      <TabItem Header="Auth" FontSize="14">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,4">
            <Button Classes="link" Content="Sobreescribir" Command="{Binding OverrideAuthCommand}">
              <Button.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="AuthInherited" /><Binding Path="CanEdit" /></MultiBinding></Button.IsVisible>
            </Button>
            <Button Classes="link" Content="Volver a heredar" Command="{Binding InheritAuthCommand}">
              <Button.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="AuthOverridden" /><Binding Path="CanEdit" /></MultiBinding></Button.IsVisible>
            </Button>
          </StackPanel>
          <Grid>
            <TextBlock IsVisible="{Binding AuthInherited}" Text="{Binding InheritedAuth}" />
            <ContentControl Content="{Binding Auth}" IsVisible="{Binding AuthOverridden}" />
          </Grid>
        </DockPanel>
      </TabItem>
      <TabItem Header="Opciones" FontSize="14">
        <StackPanel Spacing="10" Margin="0,8" MaxWidth="460" HorizontalAlignment="Left">
          <TextBlock Classes="caption" Text="Se comparten con el request y se guardan solo en este equipo." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock VerticalAlignment="Center" Text="Timeout (segundos)" />
            <TextBox Width="190" Text="{Binding TimeoutText}" Watermark="{Binding TimeoutHint}" />
          </StackPanel>
          <CheckBox IsChecked="{Binding AcceptInvalidCertificates}" Content="Aceptar certificados inválidos (APIs internas)" />
        </StackPanel>
      </TabItem>
    </TabControl>

    <GridSplitter Grid.Row="3" ResizeDirection="Rows" Background="Transparent" />
    <ContentControl Grid.Row="4" Content="{Binding Response}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
  </Grid>
</UserControl>
