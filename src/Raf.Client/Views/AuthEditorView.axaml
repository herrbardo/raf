<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Raf.Client.ViewModels"
             xmlns:ctl="using:Raf.Client.Controls"
             x:Class="Raf.Client.Views.AuthEditorView"
             x:DataType="vm:AuthEditorViewModel">
  <StackPanel Spacing="8" Margin="0,4" MaxWidth="560" HorizontalAlignment="Stretch">
    <ComboBox Width="190" ItemsSource="{Binding AvailableTypes}" SelectedItem="{Binding Type}" IsEnabled="{Binding CanEdit}" />

    <StackPanel Spacing="4" IsVisible="{Binding IsBearer}">
      <TextBlock Classes="caption" Text="Token" />
      <ctl:TextField BoundText="{Binding Token}" IsReadOnly="{Binding IsReadOnly}" />
    </StackPanel>

    <StackPanel Spacing="4" IsVisible="{Binding IsBasic}">
      <TextBlock Classes="caption" Text="Usuario" />
      <ctl:TextField BoundText="{Binding Username}" IsReadOnly="{Binding IsReadOnly}" />
      <TextBlock Classes="caption" Text="Contraseña" />
      <TextBox Text="{Binding Password}" PasswordChar="•" IsReadOnly="{Binding IsReadOnly}" />
    </StackPanel>

    <StackPanel Spacing="4" IsVisible="{Binding IsApiKey}">
      <TextBlock Classes="caption" Text="Nombre" />
      <ctl:TextField BoundText="{Binding ApiKeyName}" IsReadOnly="{Binding IsReadOnly}" />
      <TextBlock Classes="caption" Text="Valor" />
      <ctl:TextField BoundText="{Binding ApiKeyValue}" IsReadOnly="{Binding IsReadOnly}" />
      <TextBlock Classes="caption" Text="Enviar en" />
      <ComboBox Width="190" ItemsSource="{Binding AvailableLocations}" SelectedItem="{Binding ApiKeyIn}" IsEnabled="{Binding CanEdit}" />
    </StackPanel>
  </StackPanel>
</UserControl>
