<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Raf.Client.ViewModels"
        xmlns:ctl="using:Raf.Client.Controls"
        x:Class="Raf.Client.Views.AdminWindow"
        x:DataType="vm:AdminViewModel"
        Title="Administración del servidor"
        Width="920" Height="600" MinWidth="700" MinHeight="420"
        WindowStartupLocation="CenterOwner">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="dialog-footer">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ctl:Icon Data="{StaticResource IconRefresh}" />
              <TextBlock VerticalAlignment="Center" Text="Actualizar" />
            </StackPanel>
          </Button>
          <Button Content="Cerrar" Click="OnCloseClick" />
        </StackPanel>
        <TextBlock Classes="error" VerticalAlignment="Center" Margin="0,0,12,0" Text="{Binding Error}"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </DockPanel>
    </Border>

    <TabControl Classes="section" Margin="20,8,20,12" Padding="0,10,0,0">
      <TabItem Header="Usuarios">
        <Grid ColumnDefinitions="*,16,320">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <Button DockPanel.Dock="Right" Margin="8,0,0,0" Command="{Binding NewUserCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <ctl:Icon Data="{StaticResource IconPlus}" />
                  <TextBlock VerticalAlignment="Center" Text="Nuevo usuario" />
                </StackPanel>
              </Button>
              <TextBox Text="{Binding Search}" Watermark="Buscar por nombre o email" />
            </DockPanel>
            <ListBox ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:UserRow">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="caption" Text="{Binding Email}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="caption" FontWeight="SemiBold" Text="{Binding Badges}"
                               IsVisible="{Binding Badges, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <Border Grid.Column="2" Classes="group" Padding="16">
            <Panel>
              <StackPanel Classes="empty" IsVisible="{Binding !IsEditing}">
                <ctl:Icon Data="{StaticResource IconUser}" />
                <TextBlock Classes="caption" Text="Elegí un usuario de la lista o creá uno nuevo." />
              </StackPanel>
              <StackPanel Spacing="12" IsVisible="{Binding IsEditing}">
                <TextBlock Classes="heading" Text="{Binding EditorTitle}" TextTrimming="CharacterEllipsis" />
                <StackPanel Spacing="6">
                  <TextBlock Classes="label" Text="Email (es el usuario para entrar)" />
                  <TextBox Text="{Binding EditEmail}" />
                </StackPanel>
                <StackPanel Spacing="6">
                  <TextBlock Classes="label" Text="Nombre" />
                  <TextBox Text="{Binding EditName}" />
                </StackPanel>
                <CheckBox IsChecked="{Binding EditIsAdmin}" Content="Admin del servidor" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="accent" Content="{Binding SaveText}" Command="{Binding SaveUserCommand}" IsEnabled="{Binding !IsBusy}" />
                  <Button Content="Cancelar" Command="{Binding CancelEditCommand}" />
                </StackPanel>
                <Separator Margin="0,4" IsVisible="{Binding CanResetPassword}" />
                <StackPanel Spacing="8" IsVisible="{Binding CanResetPassword}">
                  <Button Content="Resetear contraseña" Command="{Binding ResetPasswordCommand}" IsEnabled="{Binding !IsBusy}" />
                  <Button Classes="danger" Content="{Binding ToggleDisabledText}" Command="{Binding ToggleDisabledCommand}"
                          IsVisible="{Binding CanToggleDisabled}" IsEnabled="{Binding !IsBusy}" />
                  <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding !CanToggleDisabled}"
                             Text="No podés deshabilitar tu propia cuenta." />
                </StackPanel>
              </StackPanel>
            </Panel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Workspaces">
        <DockPanel>
          <Border DockPanel.Dock="Bottom" Classes="group" Margin="0,12,0,0">
            <StackPanel Spacing="10">
              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="Reasignar el Owner sirve cuando el actual fue deshabilitado o dejó el equipo. El Owner anterior queda como Editor." />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding OwnerCandidates}" SelectedItem="{Binding NewOwner}"
                          PlaceholderText="Nuevo Owner">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:UserRow">
                      <TextBlock TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Name}" />
                        <Run Text=" · " />
                        <Run Classes="caption" Text="{Binding Email}" />
                      </TextBlock>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1" Content="Reasignar Owner" Command="{Binding ReassignOwnerCommand}" />
              </Grid>
            </StackPanel>
          </Border>
          <ListBox ItemsSource="{Binding Workspaces}" SelectedItem="{Binding SelectedWorkspace}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:AdminWorkspaceRow">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="caption" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding OwnerText}" />
                    <Run Text=" · " />
                    <Run Text="{Binding MembersText}" />
                  </TextBlock>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
