<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Raf.Client.ViewModels"
             xmlns:ctl="using:Raf.Client.Controls"
             x:Class="Raf.Client.Views.KeyValueListView"
             x:DataType="vm:KeyValueListViewModel">
  <DockPanel>
    <Button DockPanel.Dock="Bottom" Classes="link" Margin="0,6,0,0" Content="+ Agregar"
            Command="{Binding AddCommand}" IsVisible="{Binding CanEdit}" />
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:KeyValueRowViewModel">
            <Grid ColumnDefinitions="Auto,*,2*,Auto" ColumnSpacing="6" Margin="0,2,10,2">
              <CheckBox MinWidth="0" IsChecked="{Binding Enabled}" IsEnabled="{Binding CanEdit}" />
              <ctl:TextField Grid.Column="1" BoundText="{Binding Key}" IsReadOnly="{Binding IsReadOnly}" />
              <ctl:TextField Grid.Column="2" BoundText="{Binding Value}" IsReadOnly="{Binding IsReadOnly}" />
              <Button Grid.Column="3" Classes="link" Content="✕" Command="{Binding RemoveCommand}" IsVisible="{Binding CanEdit}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
