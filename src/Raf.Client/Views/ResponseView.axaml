<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Raf.Client.ViewModels"
             xmlns:ctl="using:Raf.Client.Controls"
             x:Class="Raf.Client.Views.ResponseView"
             x:DataType="vm:ResponseViewModel">
  <Grid>
    <StackPanel Classes="empty" IsVisible="{Binding ShowPlaceholder}">
      <ctl:Icon Data="{StaticResource IconSend}" />
      <TextBlock Classes="empty-title" Text="Todavía no hay respuesta" />
      <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
        <TextBlock Classes="caption" VerticalAlignment="Center" Text="Enviá el request con" />
        <Border Classes="kbd"><TextBlock Text="Ctrl+Enter" /></Border>
      </StackPanel>
    </StackPanel>
    <StackPanel Classes="empty" IsVisible="{Binding ShowSending}">
      <TextBlock Classes="empty-title" Text="Enviando…" />
    </StackPanel>

    <!-- La respuesta anterior queda visible mientras se envía de nuevo: el layout no salta -->
    <DockPanel IsVisible="{Binding HasResult}" Margin="14,10,14,8">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <CheckBox MinHeight="0" Content="Ver crudo" IsChecked="{Binding ShowRaw}" IsVisible="{Binding HasBody}" />
          <Button Classes="link" Content="Guardar a archivo" Command="{Binding SaveCommand}" IsVisible="{Binding HasBody}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="16">
          <Border Classes="chip" Classes.success="{Binding IsSuccess}" Classes.failure="{Binding IsHttpError}"
                  ToolTip.Tip="Código de estado">
            <TextBlock Text="{Binding StatusText}" />
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="5" ToolTip.Tip="Tiempo total">
            <ctl:Icon Classes="node" Width="13" Height="13" Data="{StaticResource IconClock}" />
            <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding TimeText}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="5" ToolTip.Tip="Tamaño del cuerpo"
                      IsVisible="{Binding SizeText, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ctl:Icon Classes="node" Width="13" Height="13" Data="{StaticResource IconSize}" />
            <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding SizeText}" />
          </StackPanel>
        </StackPanel>
      </DockPanel>
      <TextBlock DockPanel.Dock="Top" Classes="error" Margin="0,4,0,0" Text="{Binding ErrorText}"
                 IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock DockPanel.Dock="Top" Classes="warning" Margin="0,4,0,0" Text="{Binding TruncatedText}"
                 IsVisible="{Binding TruncatedText, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TabControl Classes="section" Padding="0,6,0,0">
        <TabItem Header="Body">
          <ctl:TextField Multiline="True" IsReadOnly="True" HighlightVariables="False"
                         BoundText="{Binding BodyText, Mode=OneWay}" Syntax="{Binding Syntax}" />
        </TabItem>
        <TabItem Header="Headers">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Headers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ResponseHeaderRow">
                  <Border Classes="header-row">
                    <Grid ColumnDefinitions="240,*" ColumnSpacing="12">
                      <SelectableTextBlock Classes="header-name mono" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <SelectableTextBlock Grid.Column="1" Classes="mono" TextWrapping="Wrap" Text="{Binding Value}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </DockPanel>

    <ProgressBar Classes="thin" IsIndeterminate="True" VerticalAlignment="Top" IsVisible="{Binding IsRunning}" />
  </Grid>
</UserControl>
