<!--
  Estilos compartidos de RAF. Sin colores literales: todo sale de Theme.axaml con DynamicResource.
  Clases: tipografía (caption, title...), botones (link, icon, ghost), superficies (chrome, sidebar, card...),
  pestañas (documents, section), estados (chip, sync, dirty) y estados vacíos (empty).
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Raf.Client.Controls">

  <!-- ===== Base ===== -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource RafWindowBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource RafFontSizeBody}" />
  </Style>

  <!-- ===== Tipografía ===== -->
  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="{DynamicResource RafFontSizeDisplay}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="{DynamicResource RafFontSizeTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.heading">
    <Setter Property="FontSize" Value="{DynamicResource RafFontSizeHeading}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.caption, SelectableTextBlock.caption">
    <Setter Property="FontSize" Value="{DynamicResource RafFontSizeSmall}" />
    <Setter Property="Foreground" Value="{DynamicResource RafTextSecondaryBrush}" />
  </Style>
  <Style Selector="Run.caption">
    <Setter Property="FontSize" Value="{DynamicResource RafFontSizeSmall}" />
    <Setter Property="Foreground" Value="{DynamicResource RafTextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource RafTextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="{DynamicResource RafFontSizeSmall}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource RafTextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.mono, SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource RafMonoFont}" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource RafDangerBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{DynamicResource RafWarningBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBox.mono">
    <Setter Property="FontFamily" Value="{DynamicResource RafMonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource RafFontSizeBody}" />
  </Style>

  <!-- ===== Botones ===== -->
  <Style Selector="Button, ToggleButton">
    <Setter Property="CornerRadius" Value="{DynamicResource RafRadius}" />
  </Style>

  <!-- Acción secundaria en texto, con el color del acento -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="FontSize" Value="{DynamicResource RafFontSizeSmall}" />
    <Setter Property="Foreground" Value="{DynamicResource RafAccentTextBrush}" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RafAccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RafAccentTextBrush}" />
  </Style>
  <Style Selector="Button.link:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource RafTextMutedBrush}" />
  </Style>

  <!-- Botón de solo icono, o de icono y texto en barras -->
  <Style Selector="Button.icon, Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource RafTextSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Padding" Value="7" />
    <Setter Property="MinWidth" Value="30" />
    <Setter Property="MinHeight" Value="30" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Padding" Value="9,6" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RafHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RafTextBrush}" />
  </Style>
  <Style Selector="Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RafSelectedBrush}" />
  </Style>
  <Style Selector="Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource RafTextMutedBrush}" />
  </Style>
  <Style Selector="Button.icon.small">
    <Setter Property="Padding" Value="4" />
    <Setter Property="MinWidth" Value="22" />
    <Setter Property="MinHeight" Value="22" />
  </Style>
  <Style Selector="Button.icon.small ctl|Icon">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource RafDangerBrush}" />
  </Style>
  <!-- Botón que pide atención (consola con advertencias sin ver): color de aviso y un número al lado del icono -->
  <Style Selector="Button.icon.attention">
    <Setter Property="Foreground" Value="{DynamicResource RafWarningBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource RafFontSizeSmall}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.icon.attention:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource RafWarningBrush}" />
  </Style>

  <!-- Botón principal: acento sólido con texto blanco en ambos temas -->
  <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RafAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RafOnAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RafAccentBrush}" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RafAccentHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RafOnAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RafAccentHoverBrush}" />
  </Style>
  <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RafAccentPressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RafOnAccentBrush}" />
  </Style>
  <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RafAccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RafTextMutedBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <!-- Botones principales del editor: mismo ancho, así Enviar y Cancelar se reemplazan sin mover nada -->
  <Style Selector="Button.primary-action">
    <Setter Property="MinWidth" Value="104" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <!-- ===== Superficies ===== -->
  <Style Selector="Border.chrome">
    <Setter Property="Background" Value="{DynamicResource RafChromeBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RafBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.statusbar">
    <Setter Property="Background" Value="{DynamicResource RafChromeBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RafBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="12,4" />
  </Style>
  <Style Selector="Border.sidebar">
    <Setter Property="Background" Value="{DynamicResource RafSidebarBrush}" />
  </Style>
  <Style Selector="Border.surface">
    <Setter Property="Background" Value="{DynamicResource RafSurfaceBrush}" />
  </Style>
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource RafPanelBrush}" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource RafRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RafBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RafRadiusLarge}" />
    <Setter Property="BoxShadow" Value="{DynamicResource RafCardShadow}" />
    <Setter Property="Padding" Value="32,28" />
  </Style>
  <Style Selector="Border.group">
    <Setter Property="Background" Value="{DynamicResource RafRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RafBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RafRadius}" />
    <Setter Property="Padding" Value="14" />
  </Style>
  <Style Selector="Border.dialog-footer">
    <Setter Property="Background" Value="{DynamicResource RafChromeBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RafBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="20,12" />
  </Style>
  <Style Selector="Border.update-banner">
    <Setter Property="Background" Value="{DynamicResource RafAccentBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource RafOnAccentBrush}" />
  </Style>
  <Style Selector="Border.update-banner TextBlock.caption">
    <Setter Property="Foreground" Value="{DynamicResource RafOnAccentBrush}" />
  </Style>
  <Style Selector="Border.update-banner Run.caption">
    <Setter Property="Foreground" Value="{DynamicResource RafOnAccentBrush}" />
  </Style>

  <!-- ===== Separadores redimensionables: línea fina, resaltada al pasar el mouse ===== -->
  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent">
          <Border Name="PART_Line" Background="{DynamicResource RafBorderBrush}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="GridSplitter[ResizeDirection=Columns]">
    <Setter Property="Cursor" Value="SizeWestEast" />
  </Style>
  <Style Selector="GridSplitter[ResizeDirection=Columns] /template/ Border#PART_Line">
    <Setter Property="Width" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="GridSplitter[ResizeDirection=Rows]">
    <Setter Property="Cursor" Value="SizeNorthSouth" />
  </Style>
  <Style Selector="GridSplitter[ResizeDirection=Rows] /template/ Border#PART_Line">
    <Setter Property="Height" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="GridSplitter:pointerover /template/ Border#PART_Line">
    <Setter Property="Background" Value="{DynamicResource RafAccentBrush}" />
  </Style>
  <Style Selector="GridSplitter[ResizeDirection=Columns]:pointerover /template/ Border#PART_Line">
    <Setter Property="Width" Value="2" />
  </Style>
  <Style Selector="GridSplitter[ResizeDirection=Rows]:pointerover /template/ Border#PART_Line">
    <Setter Property="Height" Value="2" />
  </Style>

  <!-- ===== Pestañas ===== -->
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="12,0" />
  </Style>

  <!-- Secciones del editor y de la respuesta: compactas y subrayadas -->
  <Style Selector="TabControl.section TabItem">
    <Setter Property="FontSize" Value="{DynamicResource RafFontSizeBody}" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Foreground" Value="{DynamicResource RafTextSecondaryBrush}" />
  </Style>
  <Style Selector="TabControl.section TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource RafTextBrush}" />
  </Style>

  <!-- Requests abiertos: pestañas de navegador -->
  <Style Selector="TabControl.documents">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource RafChromeBrush}" />
  </Style>
  <Style Selector="TabControl.documents /template/ ContentPresenter#PART_SelectedContentHost">
    <Setter Property="Background" Value="{DynamicResource RafSurfaceBrush}" />
  </Style>
  <Style Selector="TabControl.documents /template/ ItemsPresenter#PART_ItemsPresenter">
    <Setter Property="Margin" Value="6,6,6,0" />
  </Style>
  <Style Selector="TabControl.documents > TabItem">
    <Setter Property="FontSize" Value="{DynamicResource RafFontSizeBody}" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="12,0,4,0" />
    <Setter Property="Margin" Value="0,0,2,0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RafRadiusTab}" />
    <Setter Property="Foreground" Value="{DynamicResource RafTextSecondaryBrush}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TabControl.documents > TabItem /template/ Border#PART_SelectedPipe">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="TabControl.documents > TabItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource RafHoverBrush}" />
  </Style>
  <Style Selector="TabControl.documents > TabItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource RafSurfaceBrush}" />
  </Style>
  <Style Selector="TabControl.documents > TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource RafTextBrush}" />
  </Style>
  <Style Selector="TabControl.documents > TabItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, TabControl.documents > TabItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource RafTextBrush}" />
  </Style>
  <!-- El botón de cierre ocupa su lugar siempre (no tapa el nombre) y se ve en la pestaña activa o al pasar el mouse -->
  <Style Selector="TabControl.documents > TabItem Button.tab-close">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="TabControl.documents > TabItem:selected Button.tab-close, TabControl.documents > TabItem:pointerover Button.tab-close">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- ===== Listas y árbol ===== -->
  <Style Selector="ctl|Icon.node">
    <Setter Property="Foreground" Value="{DynamicResource RafTextSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TreeViewItem">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="FontSize" Value="{DynamicResource RafFontSizeBody}" />
  </Style>
  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- Selección suave en árboles y listas: el acento queda para las acciones -->
  <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot, TreeViewItem:selected:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource RafSelectedBrush}" />
  </Style>
  <Style Selector="TreeViewItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{DynamicResource RafTextBrush}" />
  </Style>
  <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot">
    <Setter Property="CornerRadius" Value="{DynamicResource RafRadius}" />
    <Setter Property="Margin" Value="0,1,6,1" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="CornerRadius" Value="{DynamicResource RafRadius}" />
    <Setter Property="Margin" Value="0,1,6,1" />
    <Setter Property="Padding" Value="10,7" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RafSelectedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RafTextBrush}" />
  </Style>

  <!-- ===== Métodos HTTP ===== -->
  <Style Selector="ctl|MethodBadge">
    <Setter Property="FontFamily" Value="{DynamicResource RafMonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource RafFontSizeTiny}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ctl|MethodBadge.large">
    <Setter Property="FontSize" Value="{DynamicResource RafFontSizeBody}" />
  </Style>
  <Style Selector="ctl|MethodBadge:get"><Setter Property="Foreground" Value="{DynamicResource RafMethodGetBrush}" /></Style>
  <Style Selector="ctl|MethodBadge:post"><Setter Property="Foreground" Value="{DynamicResource RafMethodPostBrush}" /></Style>
  <Style Selector="ctl|MethodBadge:put"><Setter Property="Foreground" Value="{DynamicResource RafMethodPutBrush}" /></Style>
  <Style Selector="ctl|MethodBadge:patch"><Setter Property="Foreground" Value="{DynamicResource RafMethodPatchBrush}" /></Style>
  <Style Selector="ctl|MethodBadge:delete"><Setter Property="Foreground" Value="{DynamicResource RafMethodDeleteBrush}" /></Style>
  <Style Selector="ctl|MethodBadge:head"><Setter Property="Foreground" Value="{DynamicResource RafMethodHeadBrush}" /></Style>
  <Style Selector="ctl|MethodBadge:options"><Setter Property="Foreground" Value="{DynamicResource RafMethodOptionsBrush}" /></Style>
  <Style Selector="ctl|MethodBadge:other"><Setter Property="Foreground" Value="{DynamicResource RafMethodOtherBrush}" /></Style>

  <!-- ===== Chips de estado ===== -->
  <Style Selector="Border.chip">
    <Setter Property="CornerRadius" Value="{DynamicResource RafRadiusPill}" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="Background" Value="{DynamicResource RafNeutralSoftBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource RafNeutralBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.chip TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontFamily" Value="{DynamicResource RafMonoFont}" />
  </Style>
  <Style Selector="Border.chip.success">
    <Setter Property="Background" Value="{DynamicResource RafSuccessSoftBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource RafSuccessBrush}" />
  </Style>
  <Style Selector="Border.chip.failure">
    <Setter Property="Background" Value="{DynamicResource RafDangerSoftBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource RafDangerBrush}" />
  </Style>
  <Style Selector="Border.chip.warning">
    <Setter Property="Background" Value="{DynamicResource RafWarningSoftBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource RafWarningBrush}" />
  </Style>

  <!-- Aviso destacado dentro de una pantalla -->
  <Style Selector="Border.callout">
    <Setter Property="Background" Value="{DynamicResource RafWarningSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RafWarningBrush}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RafRadiusSmall}" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="Border.callout ctl|Icon">
    <Setter Property="Foreground" Value="{DynamicResource RafWarningBrush}" />
  </Style>

  <!-- Estado de la sincronización: punto de color + texto (el texto siempre dice el estado) -->
  <Style Selector="Button.sync">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="CornerRadius" Value="{DynamicResource RafRadiusPill}" />
    <Setter Property="FontSize" Value="{DynamicResource RafFontSizeSmall}" />
    <Setter Property="Foreground" Value="{DynamicResource RafTextSecondaryBrush}" />
  </Style>
  <Style Selector="Button.sync:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource RafTextSecondaryBrush}" />
  </Style>
  <Style Selector="Button.sync Ellipse.dot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="Fill" Value="{DynamicResource RafWarningBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.sync.synced Ellipse.dot"><Setter Property="Fill" Value="{DynamicResource RafSuccessBrush}" /></Style>
  <Style Selector="Button.sync.offline Ellipse.dot"><Setter Property="Fill" Value="{DynamicResource RafTextMutedBrush}" /></Style>
  <Style Selector="Button.sync.conflict Ellipse.dot"><Setter Property="Fill" Value="{DynamicResource RafDangerBrush}" /></Style>
  <Style Selector="Button.sync.conflict">
    <Setter Property="Background" Value="{DynamicResource RafDangerSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RafDangerBrush}" />
  </Style>
  <Style Selector="Button.sync.conflict:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RafDangerSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RafDangerBrush}" />
  </Style>

  <!-- Cambios sin guardar -->
  <Style Selector="Ellipse.dirty">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
    <Setter Property="Fill" Value="{DynamicResource RafWarningBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="ProgressBar.thin">
    <Setter Property="MinHeight" Value="2" />
    <Setter Property="Height" Value="2" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <!-- ===== Estados vacíos ===== -->
  <Style Selector="StackPanel.empty">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Spacing" Value="8" />
    <Setter Property="MaxWidth" Value="320" />
    <Setter Property="Margin" Value="16" />
  </Style>
  <Style Selector="StackPanel.empty > ctl|Icon">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="StrokeThickness" Value="1.1" />
    <Setter Property="Foreground" Value="{DynamicResource RafTextMutedBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="StackPanel.empty > TextBlock">
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="StackPanel.empty > TextBlock.empty-title">
    <Setter Property="FontSize" Value="{DynamicResource RafFontSizeHeading}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource RafTextSecondaryBrush}" />
  </Style>
  <!-- Atajo de teclado -->
  <Style Selector="Border.kbd">
    <Setter Property="Background" Value="{DynamicResource RafRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RafBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1,1,1,2" />
    <Setter Property="CornerRadius" Value="{DynamicResource RafRadiusSmall}" />
    <Setter Property="Padding" Value="6,1" />
  </Style>
  <Style Selector="Border.kbd > TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource RafMonoFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource RafTextSecondaryBrush}" />
  </Style>

  <!-- ===== Respuesta ===== -->
  <Style Selector="Border.header-row">
    <Setter Property="BorderBrush" Value="{DynamicResource RafBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="4,6" />
  </Style>
  <Style Selector="SelectableTextBlock.header-name">
    <Setter Property="Foreground" Value="{DynamicResource RafTextSecondaryBrush}" />
  </Style>
</Styles>
