<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- El workflow de release la reemplaza con el tag (v1.2.3 -> 1.2.3). -->
    <Version>0.2.0</Version>
    <Product>RAF — Requests and Friends</Product>
    <Authors>Herr Bardo</Authors>
    <Company>Herr Bardo</Company>
    <Copyright>© 2026 Herr Bardo</Copyright>
  </PropertyGroup>
</Project>
